  RewriteCond %{THE_REQUEST} ^\S+\s/+realisations/pompe-a-chaleur-air-eau(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/realisations/pompe-a-chaleur-air-eau [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+realisations/radiateurs-nouvelle-generation(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/realisations/radiateurs-nouvelle-generation [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+realisations/remplacement-chaudiere(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/realisations/remplacement-chaudiere [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+realisations/salle-de-bain(?:\.html/*|/+)[?\s]
