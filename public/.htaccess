# =============================================================================
# HFE Énergie — redirections, compression & cache (Apache / .htaccess)
# Compatible hébergement mutualisé (pas de directives Location/LocationMatch).
# =============================================================================

# Désactive la redirection automatique /page → /page/ (conflit avec format file Astro)
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# -----------------------------------------------------------------------------
# Redirections 301 — tout en mod_rewrite, cibles ABSOLUES, une seule redirection
#
# Ordre :
#   0. aucune règle ne doit se déclencher sur la réécriture interne page.html
#      (THE_REQUEST + [END], cf. ci-dessous) ;
#   1. anciennes URLs → pages actuelles ;
#   2. variantes /page/ , /page.html , /page.html/ → /page (bloc généré) ;
#   3. slash final générique (dossier ancien sur le FTP) ;
#   4. www → apex pour tout le reste (port éventuel ignoré) ;
#   5. réécriture interne /page → page.html (pas de 301 visible).
# Chaque cible commence par https://hfe-energie.fr : depuis www.* ou depuis une
# variante, on arrive en un seul saut sur l'URL canonique, sans « :443 ».
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Pas de garde-fou sur REDIRECT_STATUS : sur OVH il n'est pas posé après la
  #    réécriture interne page → page.html (boucle 301 constatée le 12/10/2026).
  #    À la place : [END] sur la réécriture interne (étape 5) et, pour les
  #    variantes de pages, une condition sur THE_REQUEST (URL réellement demandée).

  # 1. Anciennes URLs (PascalCase) → pages actuelles.
  # IMPORTANT : pas de flag [NC] ici. La casse doit être respectée, sinon une
  # règle comme ^Climatisation matcherait aussi sa cible /climatisation et
  # provoquerait une boucle de redirection (ERR_TOO_MANY_REDIRECTS).
  RewriteRule ^Accueil(?:\.html)?/*$ https://hfe-energie.fr/ [R=301,L]
  RewriteRule ^Plomberie(?:\.html)?/*$ https://hfe-energie.fr/plomberie [R=301,L]
  RewriteRule ^Climatisation(?:\.html)?/*$ https://hfe-energie.fr/climatisation [R=301,L]
  RewriteRule ^Chauffage(?:\.html)?/*$ https://hfe-energie.fr/chauffage [R=301,L]
  RewriteRule ^Particulier(?:\.html)?/*$ https://hfe-energie.fr/particuliers [R=301,L]
  RewriteRule ^Professionnel(?:\.html)?/*$ https://hfe-energie.fr/professionnels [R=301,L]
  RewriteRule ^PompeAChaleur(?:\.html)?/*$ https://hfe-energie.fr/pompe-a-chaleur [R=301,L]
  RewriteRule ^NosRealisations(?:\.html)?/*$ https://hfe-energie.fr/realisations [R=301,L]
  RewriteRule ^NosClients(?:\.html)?/*$ https://hfe-energie.fr/ [R=301,L]
  RewriteRule ^NosSolutions(?:\.html)?/*$ https://hfe-energie.fr/ [R=301,L]
  RewriteRule ^Actualites(?:\.html)?/*$ https://hfe-energie.fr/ [R=301,L]
  RewriteRule ^Contact(?:\.html)?/*$ https://hfe-energie.fr/contact [R=301,L]
  RewriteRule ^AidesFinancement(?:\.html)?/*$ https://hfe-energie.fr/aides-financement [R=301,L]

  # Page réalisations PAC air-air fusionnée dans réalisations multi-split
  RewriteRule ^realisations/pompe-a-chaleur-air-air(?:\.html)?/*$ https://hfe-energie.fr/realisations/climatisation/multi-split [R=301,L]
  RewriteRule ^en/projects/air-to-air-heat-pump(?:\.html)?/*$ https://hfe-energie.fr/en/projects/air-conditioning/multi-split [R=301,L]

  # Multi-split et PAC air-air fusionnés sous /realisations/climatisation/multi-split
  RewriteRule ^realisations/climatisation(?:\.html)?/*$ https://hfe-energie.fr/realisations/climatisation/multi-split [R=301,L]
  RewriteRule ^realisations/climatisation/pac-air-air(?:\.html)?/*$ https://hfe-energie.fr/realisations/climatisation/multi-split [R=301,L]
  RewriteRule ^en/projects/air-conditioning(?:\.html)?/*$ https://hfe-energie.fr/en/projects/air-conditioning/multi-split [R=301,L]
  RewriteRule ^en/projects/air-conditioning/pac-air-air(?:\.html)?/*$ https://hfe-energie.fr/en/projects/air-conditioning/multi-split [R=301,L]

  # Mono-split déplacé sous /realisations/climatisation/
  RewriteRule ^climatisation/mono-split(?:\.html)?/*$ https://hfe-energie.fr/realisations/climatisation/mono-split [R=301,L]
  RewriteRule ^en/air-conditioning/mono-split(?:\.html)?/*$ https://hfe-energie.fr/en/projects/air-conditioning/mono-split [R=301,L]

  # Climatisation professionnelle fusionnée dans système DRV tertiaire
  RewriteRule ^realisations/climatisation-professionnelle(?:\.html)?/*$ https://hfe-energie.fr/realisations/systeme-drv-tertiaire [R=301,L]
  RewriteRule ^en/projects/commercial-air-conditioning(?:\.html)?/*$ https://hfe-energie.fr/en/projects/commercial-vrf-system [R=301,L]

  # Chaufferie copropriété renommée PAC collective copropriété
  RewriteRule ^realisations/chaufferie-copropriete(?:\.html)?/*$ https://hfe-energie.fr/realisations/pac-collective-copropriete [R=301,L]
  RewriteRule ^en/projects/co-ownership-heating(?:\.html)?/*$ https://hfe-energie.fr/en/projects/co-ownership-air-to-water-heat-pump [R=301,L]

  # 2. Variantes des pages Astro (généré à chaque build)
  # BEGIN AUTO-SLASH-REDIRECTS
  # Généré par scripts/generate-slash-redirects.mjs — ne pas éditer à la main
  # /page/ , /page.html , /page.html/ (www ou non) → https://hfe-energie.fr/page
  RewriteCond %{THE_REQUEST} ^\S+\s/+index(?:\.html)?/*[?\s]
  RewriteRule ^ https://hfe-energie.fr/ [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+aides-financement(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/aides-financement [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+blog(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/blog [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+blog/reportage-bfm-pompes-a-chaleur-hfe(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/blog/reportage-bfm-pompes-a-chaleur-hfe [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+blog/reportage-recrutement-plomberie-chauffage-hfe(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/blog/reportage-recrutement-plomberie-chauffage-hfe [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+blog/reportage-tf1-climatisation-panasonic-lille(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/blog/reportage-tf1-climatisation-panasonic-lille [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+blog/reportage-tf1-pompe-a-chaleur-climatisation-hfe(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/blog/reportage-tf1-pompe-a-chaleur-climatisation-hfe [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+blog/tva-5-5-climatisation-reversible-ce-qui-change(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/blog/tva-5-5-climatisation-reversible-ce-qui-change [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+cgu(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/cgu [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+cgv(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/cgv [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+chauffage(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/chauffage [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+chauffage/tetes-thermostatiques(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/chauffage/tetes-thermostatiques [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+climatisation(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/climatisation [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+contact(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/contact [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+copropriete(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/copropriete [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/air-conditioning(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/air-conditioning [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/blog(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/blog [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/blog/bfm-heat-pump-report-hfe(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/blog/bfm-heat-pump-report-hfe [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/blog/recruitment-report-plumbing-heating-hfe(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/blog/recruitment-report-plumbing-heating-hfe [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/blog/reduced-vat-reversible-air-conditioning(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/blog/reduced-vat-reversible-air-conditioning [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/blog/tf1-heat-pump-air-conditioning-report-hfe(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/blog/tf1-heat-pump-air-conditioning-report-hfe [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/blog/tf1-panasonic-air-conditioning-lille-report(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/blog/tf1-panasonic-air-conditioning-lille-report [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/careers(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/careers [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/co-ownership(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/co-ownership [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/commercial(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/commercial [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/contact(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/contact [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/cookie-policy(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/cookie-policy [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/grants-and-financing(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/grants-and-financing [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/heat-pump(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/heat-pump [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/heating(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/heating [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/heating/thermostatic-radiator-valves(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/heating/thermostatic-radiator-valves [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/legal-notice(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/legal-notice [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/panasonic-partner(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/panasonic-partner [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/plumbing(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/plumbing [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/plumbing/water-softener(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/plumbing/water-softener [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/privacy-policy(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/privacy-policy [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/air-conditioning/ducted(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/air-conditioning/ducted [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/air-conditioning/mono-split(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/air-conditioning/mono-split [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/air-conditioning/multi-split(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/air-conditioning/multi-split [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/air-to-water-heat-pump(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/air-to-water-heat-pump [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/bathroom-renovation(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/bathroom-renovation [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/boiler-replacement(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/boiler-replacement [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/co-ownership-air-to-water-heat-pump(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/co-ownership-air-to-water-heat-pump [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/co2-water-softener(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/co2-water-softener [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/commercial-vrf-system(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/commercial-vrf-system [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/drago-water-treatment(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/drago-water-treatment [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/next-generation-radiators(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/next-generation-radiators [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/plumbing-repair(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/plumbing-repair [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/salt-water-softener(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/salt-water-softener [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/small-commercial-air-conditioning(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/small-commercial-air-conditioning [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/smart-thermostatic-radiator-valves(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/smart-thermostatic-radiator-valves [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/thermodynamic-water-heater(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/thermodynamic-water-heater [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/thermostatic-radiator-valves(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/thermostatic-radiator-valves [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/projects/underfloor-heating(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/projects/underfloor-heating [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/residential(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/residential [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/service-area(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/service-area [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/terms-of-sale(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/terms-of-sale [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+en/terms-of-use(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/en/terms-of-use [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+mentions-legales(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/mentions-legales [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+partenaire-panasonic(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/partenaire-panasonic [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+particuliers(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/particuliers [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+plomberie(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/plomberie [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+plomberie/adoucisseur-eau(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/plomberie/adoucisseur-eau [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+politique-de-confidentialite(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/politique-de-confidentialite [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+politique-des-cookies(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/politique-des-cookies [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+pompe-a-chaleur(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/pompe-a-chaleur [R=301,L]
