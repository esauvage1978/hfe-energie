  RewriteCond %{THE_REQUEST} ^\S+\s/+realisations/ballon-thermodynamique(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/realisations/ballon-thermodynamique [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+realisations/climatisation/gainable(?:\.html/*|/+)[?\s]
