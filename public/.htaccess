# =============================================================================
# HFE Énergie — compression & cache (Apache / .htaccess)
# Compatible hébergement mutualisé (pas de directives Location/LocationMatch).
# =============================================================================

# -----------------------------------------------------------------------------
# Redirections 301 — www & anciennes URLs
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Anciennes URLs (PascalCase) → pages actuelles.
  # IMPORTANT : pas de flag [NC] ici. La casse doit être respectée, sinon une
  # règle comme ^Climatisation matcherait aussi sa cible /climatisation et
  # provoquerait une boucle de redirection (ERR_TOO_MANY_REDIRECTS).
  RewriteRule ^Accueil/?$ https://hfe-energie.fr/ [R=301,L]
  RewriteRule ^Plomberie/?$ https://hfe-energie.fr/plomberie [R=301,L]
  RewriteRule ^Climatisation/?$ https://hfe-energie.fr/climatisation [R=301,L]
  RewriteRule ^Chauffage/?$ https://hfe-energie.fr/chauffage [R=301,L]
  RewriteRule ^Particulier/?$ https://hfe-energie.fr/particuliers [R=301,L]
  RewriteRule ^Professionnel/?$ https://hfe-energie.fr/professionnels [R=301,L]
  RewriteRule ^PompeAChaleur/?$ https://hfe-energie.fr/pompe-a-chaleur [R=301,L]
  RewriteRule ^NosRealisations/?$ https://hfe-energie.fr/realisations [R=301,L]
  RewriteRule ^NosClients/?$ https://hfe-energie.fr/ [R=301,L]
  RewriteRule ^NosSolutions/?$ https://hfe-energie.fr/ [R=301,L]
  RewriteRule ^Actualites/?$ https://hfe-energie.fr/ [R=301,L]
  RewriteRule ^Contact/?$ https://hfe-energie.fr/contact [R=301,L]
  RewriteRule ^AidesFinancement/?$ https://hfe-energie.fr/aides-financement [R=301,L]

  # Page réalisations PAC air-air fusionnée dans réalisations multi-split
  RewriteRule ^realisations/pompe-a-chaleur-air-air/?$ https://hfe-energie.fr/realisations/climatisation/multi-split [R=301,L]
  RewriteRule ^en/projects/air-to-air-heat-pump/?$ https://hfe-energie.fr/en/projects/air-conditioning/multi-split [R=301,L]

  # Multi-split et PAC air-air fusionnés sous /realisations/climatisation/multi-split/
  RewriteRule ^realisations/climatisation/?$ https://hfe-energie.fr/realisations/climatisation/multi-split [R=301,L]
  RewriteRule ^realisations/climatisation/pac-air-air/?$ https://hfe-energie.fr/realisations/climatisation/multi-split [R=301,L]
  RewriteRule ^en/projects/air-conditioning/?$ https://hfe-energie.fr/en/projects/air-conditioning/multi-split [R=301,L]
  RewriteRule ^en/projects/air-conditioning/pac-air-air/?$ https://hfe-energie.fr/en/projects/air-conditioning/multi-split [R=301,L]

  # Mono-split déplacé sous /realisations/climatisation/
  RewriteRule ^climatisation/mono-split/?$ https://hfe-energie.fr/realisations/climatisation/mono-split [R=301,L]
  RewriteRule ^en/air-conditioning/mono-split/?$ https://hfe-energie.fr/en/projects/air-conditioning/mono-split [R=301,L]

  # www → apex (chemins non gérés ci-dessus)
  RewriteCond %{HTTP_HOST} ^www\.hfe-energie\.fr$ [NC]
  RewriteRule ^(.*)$ https://hfe-energie.fr/$1 [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# Erreurs 404 — page personnalisée (statut HTTP 404 conservé)
# Fichiers générés par Astro : /404.html et /en/404/index.html
# -----------------------------------------------------------------------------

<If "%{REQUEST_URI} =~ m#^/en(/|$)#">
  ErrorDocument 404 /en/404/index.html
</If>
<Else>
  ErrorDocument 404 /404.html
</Else>

# -----------------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2

  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|bz2|rar|7z|mp4|webm|woff2?)$ no-gzip dont-vary
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Cache — Expires
# -----------------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/ld+json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# -----------------------------------------------------------------------------
# Cache — en-têtes (via fichiers / variables d'environnement)
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Assets Astro fingerprintés : /_astro/*
  RewriteRule ^_astro/ - [E=ASTRO_ASSET:1]
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  Header append Vary Accept-Encoding env=!dont-vary
</IfModule>

# -----------------------------------------------------------------------------
# Types MIME
# -----------------------------------------------------------------------------

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
