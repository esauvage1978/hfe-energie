  RewriteCond %{THE_REQUEST} ^\S+\s/+realisations/tetes-thermostatiques(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/realisations/tetes-thermostatiques [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+realisations/tetes-thermostatiques-connectees(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/realisations/tetes-thermostatiques-connectees [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+recrutement(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/recrutement [R=301,L]
  RewriteCond %{THE_REQUEST} ^\S+\s/+zone-intervention(?:\.html/*|/+)[?\s]
  RewriteRule ^ https://hfe-energie.fr/zone-intervention [R=301,L]
  # END AUTO-SLASH-REDIRECTS

  # 3. Slash final générique → sans slash, si page.html existe
  #    (THE_REQUEST : fonctionne même si un ancien dossier /page/ existe sur le FTP)
  RewriteCond %{THE_REQUEST} \s/+(.+?)/+[\s?]
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ https://hfe-energie.fr/%1 [R=301,L]

  # 4. www → apex pour toutes les autres URLs (port éventuel toléré).
  #    On repart du chemin demandé ($1), sans .html ni slash final : même si
  #    l'hébergeur a déjà réécrit l'URL en page.html, la cible reste propre.
  RewriteCond %{HTTP_HOST} ^www\.hfe-energie\.fr(?::\d+)?\.?$ [NC]
  RewriteRule ^(.*?)(?:\.html)?/*$ https://hfe-energie.fr/$1 [R=301,L]

  # 5. Pages Astro (format file : page.html) — réécriture interne sans 301 visible
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [END]

  # Assets Astro fingerprintés : /_astro/*
  RewriteRule ^_astro/ - [E=ASTRO_ASSET:1]
</IfModule>

# -----------------------------------------------------------------------------
# Erreurs 404 — page personnalisée (statut HTTP 404 conservé)
# Fichiers générés par Astro : /404.html et /en/404.html
# -----------------------------------------------------------------------------

ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2

  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|bz2|rar|7z|mp4|webm|woff2?)$ no-gzip dont-vary
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Cache — Expires
# -----------------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/ld+json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# -----------------------------------------------------------------------------
# Cache — en-têtes (via fichiers / variables d'environnement)
# -----------------------------------------------------------------------------

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  Header append Vary Accept-Encoding env=!dont-vary
</IfModule>

# -----------------------------------------------------------------------------
# Types MIME
# -----------------------------------------------------------------------------

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddCharset UTF-8 .txt
</IfModule>
