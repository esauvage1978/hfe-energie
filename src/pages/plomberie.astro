---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import StructuredData from "@components/StructuredData.astro";
import { site } from "@data/site";

const title = "Plomberie Lille : dépannage, adoucisseur, sanitaire";
const description =
  "Plombier à Lille : dépannage plomberie, installation d'adoucisseur d'eau, ballon d'eau chaude électrique, sanitaire. Intervention rapide, devis gratuit. HFE Énergie.";
const keywords = [
  "plombier Lille",
  "dépannage plomberie Lille",
  "adoucisseur d'eau Lille",
  "ballon eau chaude Lille",
];

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Plomberie", url: "/plomberie" },
];

const offers = [
  { title: "Dépannage plomberie", desc: "Fuite, canalisation bouchée, robinetterie : intervention rapide à Lille et métropole." },
  { title: "Adoucisseur d'eau", desc: "Installation d'adoucisseurs pour protéger vos canalisations et électroménagers du calcaire." },
  { title: "Ballon eau chaude", desc: "Remplacement de ballons électriques par des modèles à haute performance ou thermodynamiques." },
  { title: "Sanitaire & rénovation", desc: "Installation complète de salles de bain, WC, douches à l'italienne, robinetterie." },
];
---

<BaseLayout title={title} description={description} keywords={keywords} canonicalPath="/plomberie">
  <StructuredData type="BreadcrumbList" breadcrumbs={breadcrumbs} slot="head" />
  <StructuredData
    type="Service"
    service={{
      name: "Plomberie & sanitaire à Lille",
      description: "Dépannage plomberie, adoucisseur d'eau, ballons d'eau chaude et rénovation sanitaire à Lille et métropole.",
      slug: "plomberie",
    }}
    slot="head"
  />

  <div class="container-page">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="bg-gradient-to-br from-primary-50 to-white">
    <div class="container-page py-10 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="badge bg-primary-100 text-primary-800"><Icon name="droplet" size={12} /> Plombier</span>
          <h1 class="mt-4 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900">
            Plomberie & sanitaire à Lille
          </h1>
          <p class="mt-4 text-lg text-neutral-700">
            HFE Énergie intervient pour tous vos travaux de plomberie : dépannage rapide, installation
            d'adoucisseurs, remplacement de ballons d'eau chaude, rénovation complète de salle de bain.
          </p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={`tel:${site.phoneRaw}`} class="btn btn-primary"><Icon name="phone" size={18} /> {site.phone}</a>
            <a href="/contact" class="btn btn-outline"><Icon name="mail" size={18} /> Devis gratuit</a>
          </div>
        </div>
        <div>
          <img src="/service-plomberie.svg" alt="Plomberie à Lille" width="400" height="300" class="rounded-2xl border border-neutral-100 shadow-xl bg-white w-full" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900 max-w-3xl">
        Nos prestations de plomberie
      </h2>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {offers.map((o) => (
          <div class="card">
            <div class="w-12 h-12 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center mb-4">
              <Icon name="droplet" size={24} />
            </div>
            <h3 class="font-display font-bold text-lg text-neutral-900">{o.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{o.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner title="Une fuite, une panne, un projet sanitaire ?" subtitle="Notre équipe intervient rapidement à Lille et métropole." />
</BaseLayout>
