---
import ProjectsPage from "../../../templates/ProjectsPage.astro";
import { getProjectsGainableContent } from "@i18n/content/projects-gainable";
import { pathFor } from "@i18n";

const locale = "fr";
const content = getProjectsGainableContent(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("projectsGainable", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel=""
  projects={[]}
  cta={content.cta}
  showInstallCta={false}
/>
