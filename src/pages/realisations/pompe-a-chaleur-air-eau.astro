---
import ProjectsPage from "../../templates/ProjectsPage.astro";
import { getProjectsPacAirEauContent } from "@i18n/content/projects-pac-air-eau";
import { pathFor } from "@i18n";

const locale = "fr";
const content = getProjectsPacAirEauContent(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("projectsPacAirEau", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel={content.projectLabel}
  projects={content.projects}
  cta={content.cta}
  showInstallCta={false}
/>
