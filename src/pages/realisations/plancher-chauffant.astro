---
import ProjectsPage from "../../templates/ProjectsPage.astro";
import { getProjectsPlancherChauffantContent } from "@i18n/content/projects-plancher-chauffant";
import { pathFor } from "@i18n";

const locale = "fr";
const content = getProjectsPlancherChauffantContent(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("projectsPlancherChauffant", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel={content.projectLabel}
  projects={content.projects}
  cta={content.cta}
/>
