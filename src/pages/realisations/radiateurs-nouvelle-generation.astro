---
import ProjectsPage from "../../templates/ProjectsPage.astro";
import { getProjectsRadiateursNouvelleGenerationContent } from "@i18n/content/projects-radiateurs-nouvelle-generation";
import { pathFor } from "@i18n";

const locale = "fr";
const content = getProjectsRadiateursNouvelleGenerationContent(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("projectsRadiateursNouvelleGeneration", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel=""
  projects={[]}
  cta={content.cta}
  showInstallCta={false}
/>
