---
import ProjectsPage from "../../templates/ProjectsPage.astro";
import { getProjectsDrvTertiaireContent } from "@i18n/content/projects-drv-tertiaire";
import { pathFor } from "@i18n";

const locale = "fr";
const content = getProjectsDrvTertiaireContent(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("projectsDrvTertiaire", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel={content.projectLabel}
  projects={content.projects}
  cta={content.cta}
/>
