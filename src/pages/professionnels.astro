---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import StructuredData from "@components/StructuredData.astro";
import { site } from "@data/site";

const title = "Professionnels - Chauffage & climatisation tertiaire à Lille";
const description =
  "HFE Énergie équipe les professionnels de Lille en pompes à chaleur, climatisation tertiaire (cassette, gainable), chauffage industriel. Contrats de maintenance & dépannage.";

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Professionnels", url: "/professionnels" },
];

const offers = [
  { title: "Climatisation tertiaire", desc: "Bureaux, commerces, restaurants, cabinets médicaux : climatisation cassette, gainable, multi-split." },
  { title: "PAC industrielle", desc: "Pompes à chaleur de forte puissance pour entrepôts, ateliers, locaux industriels." },
  { title: "Maintenance préventive", desc: "Contrats de maintenance sur mesure pour assurer la disponibilité de vos équipements." },
  { title: "Dépannage 7j/7", desc: "Intervention rapide pour limiter votre arrêt d'activité - secteur Lille métropole." },
  { title: "Audit énergétique", desc: "Diagnostic et préconisations pour optimiser votre consommation et votre confort." },
  { title: "Décret tertiaire", desc: "Accompagnement à la mise en conformité avec le décret tertiaire (DEET)." },
];
---

<BaseLayout title={title} description={description} canonicalPath="/professionnels">
  <StructuredData type="BreadcrumbList" breadcrumbs={breadcrumbs} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="bg-gradient-to-br from-neutral-900 via-primary-900 to-primary-800 text-white">
    <div class="container-page py-12 md:py-20">
      <div class="max-w-3xl">
        <span class="badge bg-white/15 text-white border border-white/20">Professionnels</span>
        <h1 class="mt-3 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-white leading-tight">
          Solutions énergétiques pour <span class="text-primary-200">professionnels</span>
        </h1>
        <p class="mt-4 text-lg text-primary-100">
          Bureaux, commerces, restaurants, locaux industriels : HFE Énergie conçoit, installe et maintient
          vos équipements de chauffage et de climatisation à Lille et dans toute la métropole.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="btn btn-accent"><Icon name="mail" size={18} /> Demander un audit</a>
          <a href={`tel:${site.phoneRaw}`} class="btn bg-white text-primary-800 hover:bg-primary-50"><Icon name="phone" size={18} /> {site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900 max-w-3xl">
        Nos services dédiés aux professionnels
      </h2>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {offers.map((o) => (
          <div class="card">
            <div class="w-12 h-12 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center mb-4">
              <Icon name="shield" size={24} />
            </div>
            <h3 class="font-display font-bold text-lg text-neutral-900">{o.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{o.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner title="Un projet B2B ? Parlons-en." subtitle="Visite technique, étude personnalisée et engagement sur les délais." />
</BaseLayout>
