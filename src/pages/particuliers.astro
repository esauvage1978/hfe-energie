---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import StructuredData from "@components/StructuredData.astro";
import { site } from "@data/site";
import { servicesImages } from "@data/assets";

const title = "Particuliers - Pompe à chaleur, climatisation, chauffage à Lille";
const description =
  "HFE Énergie accompagne les particuliers de Lille et métropole : pompe à chaleur, climatisation, remplacement de chaudière, plomberie. Devis gratuit, aides MaPrimeRénov'.";

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Particuliers", url: "/particuliers" },
];

const offers = [
  {
    icon: "heat-pump",
    title: "Pompe à chaleur air-eau",
    desc: "Remplacement de chaudière par une PAC air-eau performante, compatible radiateurs ou plancher chauffant.",
    link: "/pompe-a-chaleur",
  },
  {
    icon: "snowflake",
    title: "Climatisation réversible",
    desc: "Confort été comme hiver dans chaque pièce, avec une consommation maîtrisée.",
    link: "/climatisation",
  },
  {
    icon: "flame",
    title: "Chaudière à condensation",
    desc: "Remplacement de chaudières anciennes par des modèles à condensation à haut rendement.",
    link: "/chauffage",
  },
  {
    icon: "droplet",
    title: "Chauffe-eau thermodynamique",
    desc: "Eau chaude sanitaire écologique : jusqu'à 70 % d'économies par rapport à un ballon classique.",
    link: "/pompe-a-chaleur#chauffe-eau-thermodynamique",
  },
  {
    icon: "shield",
    title: "Maintenance & entretien",
    desc: "Contrats d'entretien annuels dès 149 € TTC / an pour préserver vos équipements.",
    link: "/contact",
  },
  {
    icon: "euro",
    title: "Accompagnement aides",
    desc: "Montage de dossiers MaPrimeRénov', CEE, ANaH : nous nous occupons de tout.",
    link: "/aides-financement",
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/particuliers">
  <StructuredData type="BreadcrumbList" breadcrumbs={breadcrumbs} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="bg-gradient-to-br from-primary-50 to-white">
    <div class="container-page py-10 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="badge bg-primary-100 text-primary-800">Particuliers</span>
          <h1 class="mt-3 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
            Votre confort thermique <span class="text-primary-700">clé en main</span>
          </h1>
          <p class="mt-4 text-lg text-neutral-700">
            HFE Énergie accompagne les particuliers de Lille et métropole dans tous leurs projets d'énergie
            renouvelable : pompe à chaleur, climatisation, chauffage, plomberie. Un seul interlocuteur, de
            l'étude au SAV.
          </p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href="/contact" class="btn btn-primary"><Icon name="mail" size={18} /> Demander un devis</a>
            <a href={`tel:${site.phoneRaw}`} class="btn btn-outline"><Icon name="phone" size={18} /> {site.phone}</a>
          </div>
        </div>
        <div>
          <Picture
            src={servicesImages.particuliers.src}
            alt={servicesImages.particuliers.alt}
            width={servicesImages.particuliers.width}
            height={servicesImages.particuliers.height}
            class="rounded-3xl shadow-xl border border-neutral-100 w-full aspect-[4/3] object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900 max-w-3xl">
        Nos solutions pour votre maison
      </h2>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {offers.map((o) => (
          <a href={o.link} class="card group">
            <div class="w-12 h-12 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center mb-4 group-hover:bg-primary-600 group-hover:text-white transition-colors">
              <Icon name={o.icon} size={24} />
            </div>
            <h3 class="font-display font-bold text-lg text-neutral-900">{o.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{o.desc}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primary-700 group-hover:gap-2 transition-all">
              Découvrir <Icon name="arrow-right" size={16} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner title="Lancez votre projet de rénovation énergétique" subtitle="Étude gratuite, conseil personnalisé, accompagnement des aides." />
</BaseLayout>
