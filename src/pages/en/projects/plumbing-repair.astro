---
import ProjectsPage from "../../../templates/ProjectsPage.astro";
import { getProjectsDepannagePlomberieContent } from "@i18n/content/projects-depannage-plomberie";
import { pathFor } from "@i18n";
import { site } from "@data/site";

const locale = "en";
const content = getProjectsDepannagePlomberieContent(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("projectsDepannagePlomberie", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel=""
  projects={[]}
  cta={content.cta}
  phone={site.plumbingPhone}
  phoneRaw={site.plumbingPhoneRaw}
  showInstallCta={false}
/>
