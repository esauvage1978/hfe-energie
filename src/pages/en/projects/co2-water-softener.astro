---
import ProjectsPage from "../../../templates/ProjectsPage.astro";
import { getProjectsAdoucisseurCo2Content } from "@i18n/content/projects-adoucisseur-co2";
import { pathFor } from "@i18n";
import { site } from "@data/site";

const locale = "en";
const content = getProjectsAdoucisseurCo2Content(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("projectsAdoucisseurCo2", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel=""
  projects={[]}
  cta={content.cta}
  phone={site.plumbingPhone}
  phoneRaw={site.plumbingPhoneRaw}
  showInstallCta={false}
/>
