---
import ProjectsPage from "../../../templates/ProjectsPage.astro";
import { getProjectsBallonThermodynamiqueContent } from "@i18n/content/projects-ballon-thermodynamique";
import { pathFor } from "@i18n";

const locale = "en";
const content = getProjectsBallonThermodynamiqueContent(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("projectsBallonThermodynamique", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel={content.projectLabel}
  projects={content.projects}
  cta={content.cta}
/>
