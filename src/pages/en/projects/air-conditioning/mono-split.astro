---
import ProjectsPage from "../../../../templates/ProjectsPage.astro";
import { getClimatisationMonoSplitContent } from "@i18n/content/climatisation-mono-split";
import { pathFor } from "@i18n";

const locale = "en";
const content = getClimatisationMonoSplitContent(locale);
---
<ProjectsPage
  locale={locale}
  seo={content.seo}
  breadcrumbs={[...content.breadcrumbs]}
  canonicalPath={pathFor("climatisationMonoSplit", locale)}
  hero={content.hero}
  intro={content.intro}
  projectLabel={content.projectLabel}
  projects={content.projects}
  cta={content.cta}
/>
