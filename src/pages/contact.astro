---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Icon from "@components/Icon.astro";
import StructuredData from "@components/StructuredData.astro";
import ContactForm from "@components/ContactForm.tsx";
import { site } from "@data/site";

const title = "Contact - Devis gratuit pompe à chaleur Lille";
const description =
  "Contactez HFE Énergie à Lille pour un devis gratuit : pompe à chaleur, climatisation, chauffage, plomberie. Réponse sous 24h, intervention sur toute la métropole.";

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Contact", url: "/contact" },
];
---

<BaseLayout title={title} description={description} canonicalPath="/contact">
  <StructuredData type="BreadcrumbList" breadcrumbs={breadcrumbs} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section bg-gradient-to-br from-primary-50 via-white to-accent-50/20">
    <div class="container-page">
      <div class="max-w-3xl">
        <span class="badge bg-primary-100 text-primary-800"><Icon name="mail" size={12} /> Contact</span>
        <h1 class="mt-3 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
          Parlons de votre projet
        </h1>
        <p class="mt-4 text-lg text-neutral-700">
          Décrivez votre projet de pompe à chaleur, climatisation, chauffage ou plomberie. Nous vous
          recontactons sous 24h avec une première estimation et une proposition de rendez-vous.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <ContactForm client:visible />
        </div>

        <aside class="space-y-6">
          <div class="rounded-2xl bg-white border border-neutral-200 p-6 shadow-sm">
            <h2 class="font-display font-bold text-lg text-neutral-900">Coordonnées</h2>
            <ul class="mt-4 space-y-4">
              <li class="flex items-start gap-3">
                <Icon name="map-pin" size={20} class="text-primary-600 mt-0.5 shrink-0" />
                <address class="not-italic text-sm text-neutral-700 leading-relaxed">
                  <strong class="block text-neutral-900">{site.legalName}</strong>
                  {site.address.street}<br />
                  {site.address.postalCode} {site.address.city}<br />
                  {site.address.country}
                </address>
              </li>
              <li class="flex items-center gap-3">
                <Icon name="phone" size={20} class="text-primary-600 shrink-0" />
                <a href={`tel:${site.phoneRaw}`} class="text-base font-semibold text-primary-700">
                  {site.phone}
                </a>
              </li>
              <li class="flex items-center gap-3">
                <Icon name="mail" size={20} class="text-primary-600 shrink-0" />
                <a href={`mailto:${site.email}`} class="text-sm text-primary-700 break-all">
                  {site.email}
                </a>
              </li>
            </ul>
          </div>

          <div class="rounded-2xl bg-neutral-900 text-white p-6">
            <h2 class="font-display font-bold text-lg text-white flex items-center gap-2">
              <Icon name="clock" size={20} />
              Horaires
            </h2>
            <ul class="mt-4 space-y-2 text-sm">
              {site.hours.map((h) => (
                <li class="flex justify-between text-neutral-300">
                  <span>{h.day}</span>
                  <span class="text-white font-medium">{h.value}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl bg-accent-50 border border-accent-200 p-6">
            <h2 class="font-display font-bold text-lg text-accent-900 flex items-center gap-2">
              <Icon name="shield" size={20} />
              Urgence ?
            </h2>
            <p class="mt-2 text-sm text-accent-900/80">
              Pour toute panne urgente (chauffage, fuite), appelez-nous directement. Intervention rapide sur
              Lille métropole.
            </p>
            <a href={`tel:${site.phoneRaw}`} class="btn btn-accent w-full mt-4">
              <Icon name="phone" size={16} />
              {site.phone}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-white border-t border-neutral-200">
    <div class="container-page py-10">
      <h2 class="font-display text-2xl md:text-3xl font-extrabold text-neutral-900 mb-4">
        Nous trouver à Lille
      </h2>
      <div class="rounded-2xl overflow-hidden border border-neutral-200 aspect-[16/9] md:aspect-[21/9] bg-neutral-100">
        <iframe
          title="Carte de localisation HFE Énergie à Lille"
          src="https://www.openstreetmap.org/export/embed.html?bbox=3.04,50.62,3.08,50.66&layer=mapnik&marker=50.6378,3.0573"
          width="100%"
          height="100%"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          style="border: 0;"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
