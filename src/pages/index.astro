---
import BaseLayout from "@layouts/BaseLayout.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import LogoCloud from "@components/LogoCloud.astro";
import StructuredData from "@components/StructuredData.astro";
import Faq from "@components/Faq.tsx";
import SavingsCalculator from "@components/SavingsCalculator.tsx";
import { services, certifications, site } from "@data/site";
import { heroes, logos, partenaires, clientsReferences, certificationsLogos } from "@data/assets";

const title = "Pompe à chaleur Lille - Installateur RGE QualiPAC";
const description =
  "HFE Énergie - Installation de pompe à chaleur à Lille et métropole. Artisan RGE QualiPAC, devis gratuit, MaPrimeRénov'. 15 ans d'expérience, 1500+ installations.";

const keywords = [
  "pompe à chaleur Lille",
  "PAC air-eau Lille",
  "installateur RGE Lille",
  "climatisation Lille",
  "chauffagiste Lille",
  "MaPrimeRénov pompe à chaleur",
  "HFE Énergie",
  "Hecker Frères Énergie",
];

const heroBullets = [
  "Étude thermique personnalisée gratuite",
  "Installateur RGE QualiPAC",
  "Aides MaPrimeRénov' & CEE",
  "Garantie décennale",
];

const homeFaqs = [
  {
    question: "Pourquoi installer une pompe à chaleur en 2026 ?",
    answer:
      "La pompe à chaleur (PAC) est le système de chauffage le plus performant et le plus économique du marché. Elle utilise une énergie renouvelable (l'air extérieur) pour chauffer votre logement avec un rendement (SCOP) compris entre 3,5 et 4,5 : pour 1 kWh d'électricité consommé, la PAC restitue 3,5 à 4,5 kWh de chaleur. Vous réduisez ainsi votre facture de chauffage jusqu'à 75 % par rapport à un chauffage électrique ou au fioul, tout en bénéficiant de MaPrimeRénov' et des CEE.",
  },
  {
    question: "Quelles sont les aides disponibles pour une PAC en 2026 ?",
    answer:
      "Trois dispositifs principaux sont cumulables : MaPrimeRénov' (jusqu'à 5 000 € pour une PAC air-eau selon vos revenus), les Certificats d'Économie d'Énergie (CEE, dits « Coup de pouce chauffage », jusqu'à 5 500 €) et le taux de TVA réduit à 5,5 % sur la fourniture et la pose. HFE Énergie est certifiée RGE QualiPAC : votre projet est donc éligible à l'ensemble de ces aides. Nous vous accompagnons dans le montage de votre dossier.",
  },
  {
    question: "Quelle est votre zone d'intervention ?",
    answer:
      "Nous intervenons sur tout Lille et la Métropole Européenne de Lille (MEL) dans un rayon d'environ 30 km : La Madeleine, Marcq-en-Barœul, Villeneuve-d'Ascq, Roubaix, Tourcoing, Wasquehal, Lambersart, Lomme, Hellemmes, Wambrechies, Saint-André-lez-Lille et les communes alentours.",
  },
  {
    question: "Combien de temps dure l'installation d'une pompe à chaleur ?",
    answer:
      "Pour une pompe à chaleur air-eau standard chez un particulier, comptez 2 à 3 jours d'intervention. Pour une PAC air-air (climatisation réversible), une installation mono-split prend 1 journée. Une étude technique préalable est réalisée pour dimensionner correctement votre équipement.",
  },
  {
    question: "Quelle est la durée de vie d'une pompe à chaleur ?",
    answer:
      "Une PAC bien entretenue dure 15 à 20 ans. Un entretien annuel obligatoire (depuis le décret du 30 juillet 2020) est indispensable pour garantir performance et longévité. HFE Énergie propose des contrats d'entretien à partir de 149 € TTC / an incluant le contrôle d'étanchéité du circuit frigorifique.",
  },
];

const breadcrumbs = [{ name: "Accueil", url: "/" }];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="/"
>
  <StructuredData type="BreadcrumbList" breadcrumbs={breadcrumbs} slot="head" />
  <StructuredData type="FAQPage" faqs={homeFaqs} slot="head" />

  <section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-accent-50/30">
    <div class="absolute inset-0 -z-10 opacity-50">
      <div class="absolute top-10 right-10 w-72 h-72 bg-primary-200 rounded-full blur-3xl opacity-60"></div>
      <div class="absolute bottom-10 left-10 w-72 h-72 bg-accent-200 rounded-full blur-3xl opacity-40"></div>
    </div>

    <div class="container-page pt-10 pb-12 md:pt-16 md:pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">
        <div class="order-2 lg:order-1">
          <span class="badge bg-primary-100 text-primary-800 border border-primary-200">
            <Icon name="shield" size={12} />
            Artisan RGE QualiPAC
          </span>
          <h1 class="mt-4 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] leading-[1.1] text-neutral-900">
            <span class="text-primary-700">Pompe à chaleur</span> à Lille :<br class="hidden sm:inline" />
            jusqu'à <span class="text-accent-600">75 % d'économies</span> sur votre chauffage
          </h1>
          <p class="mt-5 text-base md:text-lg text-neutral-700 leading-relaxed">
            HFE Énergie, votre chauffagiste-climaticien à <strong>Lille et métropole</strong>, installe des
            pompes à chaleur air-eau et air-air haute performance, éligibles à <strong>MaPrimeRénov'</strong> et aux
            <strong> Certificats d'Économie d'Énergie</strong>. Étude personnalisée et devis gratuit.
          </p>

          <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
            {heroBullets.map((b) => (
              <li class="flex items-center gap-2 text-neutral-800">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary-100 text-primary-700 shrink-0">
                  <Icon name="check" size={14} strokeWidth={3} />
                </span>
                <span class="font-medium">{b}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/contact" class="btn btn-primary">
              <Icon name="mail" size={18} />
              Demander mon devis gratuit
            </a>
            <a href={`tel:${site.phoneRaw}`} class="btn btn-outline">
              <Icon name="phone" size={18} />
              {site.phone}
            </a>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-xs text-neutral-600">
            <div class="flex items-center gap-2">
              <div class="flex" aria-label="Note 5 sur 5">
                {Array.from({ length: 5 }).map(() => (
                  <Icon name="star" size={14} class="text-amber-400 fill-amber-400" />
                ))}
              </div>
              <span class="font-semibold text-neutral-800">4,9 / 5</span>
              <span>· 200+ avis clients</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="map-pin" size={14} class="text-primary-600" />
              <span>Lille & métropole · 30 km</span>
            </div>
          </div>
        </div>

        <div class="order-1 lg:order-2">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-tr from-primary-200/40 to-accent-200/40 rounded-3xl blur-2xl" aria-hidden="true"></div>
            <Picture
              src={heroes.pac.src}
              alt={heroes.pac.alt}
              width={heroes.pac.width}
              height={heroes.pac.height}
              class="relative rounded-3xl shadow-2xl border border-neutral-100 w-full aspect-[4/3] object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
            <Picture
              src={logos.devisGratuit.src}
              alt="Devis gratuit"
              width={logos.devisGratuit.width}
              height={logos.devisGratuit.height}
              class="hidden sm:block absolute -bottom-6 -right-6 w-32 h-32 lg:w-40 lg:h-40 drop-shadow-xl"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="trust-title">
    <div class="container-page">
      <h2 id="trust-title" class="sr-only">Un savoir-faire reconnu</h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        <div class="text-center">
          <p class="font-display text-3xl md:text-4xl font-extrabold text-primary-700">{site.stats.installations.toLocaleString("fr-FR")}+</p>
          <p class="mt-1 text-sm text-neutral-600 font-medium">installations réalisées</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl md:text-4xl font-extrabold text-primary-700">{site.stats.clientsPerYear}</p>
          <p class="mt-1 text-sm text-neutral-600 font-medium">clients par an</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl md:text-4xl font-extrabold text-primary-700">{site.stats.yearsExperience} ans</p>
          <p class="mt-1 text-sm text-neutral-600 font-medium">d'expérience</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl md:text-4xl font-extrabold text-primary-700">4,9/5</p>
          <p class="mt-1 text-sm text-neutral-600 font-medium">satisfaction client</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50" aria-labelledby="services-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <span class="badge bg-primary-100 text-primary-800">Nos services</span>
        <h2 id="services-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          Énergies renouvelables, confort et économies
        </h2>
        <p class="mt-3 text-neutral-700">
          Entreprise artisanale spécialisée dans les énergies renouvelables, HFE Énergie installe, maintient
          et dépanne pompes à chaleur, climatisation, chauffage et plomberie chez les particuliers comme chez
          les professionnels de Lille et de la métropole.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {services.map((service) => (
          <a href={`/${service.slug}`} class="card group flex flex-col">
            <div class="w-12 h-12 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center mb-4 group-hover:bg-primary-600 group-hover:text-white transition-colors">
              <Icon name={service.icon} size={24} />
            </div>
            <h3 class="font-display font-bold text-lg text-neutral-900">
              {service.title}
            </h3>
            <p class="mt-1 text-sm font-semibold text-primary-700">{service.short}</p>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed flex-1">
              {service.description}
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-700 group-hover:gap-2 transition-all">
              En savoir plus <Icon name="arrow-right" size={16} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="calc-title">
    <div class="container-page">
      <div class="max-w-3xl mb-8">
        <span class="badge bg-accent-100 text-accent-800">Simulateur</span>
        <h2 id="calc-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          Combien allez-vous économiser avec une pompe à chaleur ?
        </h2>
        <p class="mt-3 text-neutral-700">
          Comparez en temps réel le coût de votre chauffage actuel avec celui d'une PAC air-eau dernière
          génération. Les économies sont souvent supérieures à <strong>1 000 € par an</strong>.
        </p>
      </div>
      <SavingsCalculator client:visible />
    </div>
  </section>

  <section class="section bg-neutral-900 text-white" aria-labelledby="why-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <span class="badge bg-white/10 text-primary-200">Pourquoi nous choisir ?</span>
        <h2 id="why-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-white">
          Un partenaire de confiance pour vos travaux d'énergie
        </h2>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <div class="rounded-2xl bg-white/5 border border-white/10 p-6">
          <div class="w-12 h-12 rounded-xl bg-primary-500/20 text-primary-300 flex items-center justify-center mb-4">
            <Icon name="shield" size={24} />
          </div>
          <h3 class="font-display font-bold text-lg text-white">Certifié RGE QualiPAC</h3>
          <p class="mt-2 text-sm text-neutral-300 leading-relaxed">
            Nos certifications RGE vous permettent de bénéficier de l'intégralité des aides de l'État :
            MaPrimeRénov', CEE, TVA à 5,5 %.
          </p>
        </div>
        <div class="rounded-2xl bg-white/5 border border-white/10 p-6">
          <div class="w-12 h-12 rounded-xl bg-accent-500/20 text-accent-300 flex items-center justify-center mb-4">
            <Icon name="leaf" size={24} />
          </div>
          <h3 class="font-display font-bold text-lg text-white">Énergies renouvelables</h3>
          <p class="mt-2 text-sm text-neutral-300 leading-relaxed">
            Nous privilégions des solutions de chauffage écologiques et performantes pour réduire votre
            empreinte carbone et préserver l'environnement.
          </p>
        </div>
        <div class="rounded-2xl bg-white/5 border border-white/10 p-6">
          <div class="w-12 h-12 rounded-xl bg-accent-500/20 text-accent-300 flex items-center justify-center mb-4">
            <Icon name="euro" size={24} />
          </div>
          <h3 class="font-display font-bold text-lg text-white">Devis 100 % gratuit</h3>
          <p class="mt-2 text-sm text-neutral-300 leading-relaxed">
            Étude thermique, dimensionnement et chiffrage sont offerts, sans engagement. Vous recevez sous
            48h une proposition claire et détaillée.
          </p>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {certifications.map((c) => (
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="flex items-center gap-2 mb-2">
              <Icon name="check" size={18} class="text-primary-300" strokeWidth={3} />
              <p class="font-bold text-white text-sm">{c.name}</p>
            </div>
            <p class="text-xs text-neutral-400 leading-relaxed">{c.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50" aria-labelledby="process-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <span class="badge bg-primary-100 text-primary-800">Notre méthode</span>
        <h2 id="process-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          De la prise de contact à la mise en service
        </h2>
      </div>

      <ol class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {[
          {
            n: 1,
            t: "Échange & étude",
            d: "Premier échange téléphonique, visite technique et étude thermique de votre logement.",
          },
          {
            n: 2,
            t: "Devis personnalisé",
            d: "Proposition détaillée incluant le matériel, la pose et l'estimation des aides (MaPrimeRénov', CEE).",
          },
          {
            n: 3,
            t: "Installation soignée",
            d: "Pose réalisée par nos équipes formées (Compagnons du Devoir), partenaires Panasonic.",
          },
          {
            n: 4,
            t: "Mise en service & SAV",
            d: "Mise en service, formation à l'utilisation, contrat d'entretien et suivi sur la durée.",
          },
        ].map((step) => (
          <li class="card relative">
            <div class="absolute -top-4 left-6 flex items-center justify-center w-10 h-10 rounded-full bg-primary-700 text-white font-display font-extrabold text-lg shadow-md">
              {step.n}
            </div>
            <h3 class="mt-3 font-display font-bold text-lg">{step.t}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{step.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="team-title">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="badge bg-primary-100 text-primary-800">L'équipe HFE</span>
          <h2 id="team-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
            Une équipe artisanale formée aux Compagnons du Devoir
          </h2>
          <p class="mt-4 text-neutral-700 leading-relaxed">
            Depuis {site.stats.yearsExperience} ans, les frères Hecker et leur équipe accompagnent
            particuliers et professionnels de Lille et de la métropole dans leurs projets d'énergie
            renouvelable. Compétence technique, écoute client et engagement environnemental sont au
            cœur de notre métier.
          </p>
          <ul class="mt-6 space-y-3">
            <li class="flex items-start gap-3">
              <span class="flex items-center justify-center w-7 h-7 rounded-full bg-primary-100 text-primary-700 shrink-0">
                <Icon name="check" size={16} strokeWidth={3} />
              </span>
              <span class="text-neutral-700"><strong>Formation Compagnons du Devoir</strong> - excellence technique</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex items-center justify-center w-7 h-7 rounded-full bg-primary-100 text-primary-700 shrink-0">
                <Icon name="check" size={16} strokeWidth={3} />
              </span>
              <span class="text-neutral-700"><strong>{site.stats.installations}+ installations</strong> réalisées avec succès</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex items-center justify-center w-7 h-7 rounded-full bg-primary-100 text-primary-700 shrink-0">
                <Icon name="check" size={16} strokeWidth={3} />
              </span>
              <span class="text-neutral-700"><strong>{site.stats.clientsPerYear} clients par an</strong> nous font confiance</span>
            </li>
          </ul>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/contact" class="btn btn-primary"><Icon name="mail" size={18} /> Rencontrer l'équipe</a>
            <a href={`tel:${site.phoneRaw}`} class="btn btn-outline"><Icon name="phone" size={18} /> {site.phone}</a>
          </div>
        </div>
        <div>
          <Picture
            src={heroes.team.src}
            alt={heroes.team.alt}
            width={heroes.team.width}
            height={heroes.team.height}
            class="rounded-3xl shadow-xl border border-neutral-100 w-full aspect-[4/5] object-cover"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />

  <LogoCloud
    title="Nos partenaires constructeurs"
    subtitle="Nous installons les meilleures marques du marché, gage de fiabilité et de performance sur la durée."
    items={partenaires}
    variant="partners"
  />

  <section class="section bg-neutral-50" aria-labelledby="certif-title">
    <div class="container-page">
      <div class="max-w-3xl text-center mx-auto">
        <span class="badge bg-accent-100 text-accent-800">Certifications</span>
        <h2 id="certif-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          Un savoir-faire certifié
        </h2>
        <p class="mt-3 text-neutral-700">
          HFE Énergie est certifiée <strong>RGE QualiPAC</strong> et dispose de toutes les qualifications
          nécessaires pour vous garantir un travail conforme et l'accès aux aides de l'État.
        </p>
      </div>
      <ul class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6 items-center">
        {certificationsLogos.map((c) => (
          <li class="flex items-center justify-center p-4 rounded-xl bg-white border border-neutral-200 aspect-square">
            <Picture
              src={c.logo}
              alt={`Certification ${c.name}`}
              width={200}
              height={200}
              class="max-h-20 sm:max-h-24 w-auto object-contain"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <LogoCloud
    title="Ils nous font confiance"
    subtitle="Particuliers, restaurants, hôtels, grandes enseignes : nos clients nous recommandent."
    items={clientsReferences}
    variant="clients"
  />

  <section class="section bg-white" aria-labelledby="faq-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <span class="badge bg-primary-100 text-primary-800">FAQ</span>
        <h2 id="faq-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          Vos questions sur la pompe à chaleur
        </h2>
        <p class="mt-3 text-neutral-700">
          Tout ce que vous devez savoir avant de lancer votre projet de pompe à chaleur ou de climatisation.
        </p>
      </div>

      <div class="mt-8 max-w-4xl">
        <Faq items={homeFaqs} client:visible />
      </div>
    </div>
  </section>
</BaseLayout>
