---
import type { Locale } from "@i18n";
import { getUi } from "@i18n";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import StructuredData from "@components/StructuredData.astro";

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  updatedAt: string;
  breadcrumbLabel?: string;
  noIndex?: boolean;
}

const { locale, title, description, canonicalPath, updatedAt, breadcrumbLabel, noIndex = false } =
  Astro.props;
const { strings: t, homePath } = getUi(locale);

const breadcrumbs = [
  { name: t.legal.home, url: homePath },
  { name: breadcrumbLabel ?? title, url: canonicalPath },
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noIndex={noIndex}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={breadcrumbs} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section bg-white">
    <div class="container-page">
      <article class="max-w-3xl prose-custom">
        <header class="mb-8 pb-6 border-b border-neutral-200">
          <h1 class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">{title}</h1>
          <p class="mt-3 text-sm text-neutral-500">
            {t.legal.lastUpdated} : <time datetime={updatedAt}>{updatedAt}</time>
          </p>
        </header>

        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
