---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import StructuredData from "@components/StructuredData.astro";

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  updatedAt: string;
  noIndex?: boolean;
}

const { title, description, canonicalPath, updatedAt, noIndex = false } = Astro.props;

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: title, url: canonicalPath },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noIndex={noIndex}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={breadcrumbs} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section bg-white">
    <div class="container-page">
      <article class="max-w-3xl prose-custom">
        <header class="mb-8 pb-6 border-b border-neutral-200">
          <h1 class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">{title}</h1>
          <p class="mt-3 text-sm text-neutral-500">
            Dernière mise à jour : <time datetime={updatedAt}>{updatedAt}</time>
          </p>
        </header>

        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
