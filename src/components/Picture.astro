---
/**
 * <Picture> sert automatiquement la version optimale (AVIF > WebP > original)
 * en utilisant l'élément <picture> natif.
 *
 * Variantes générées par scripts/optimize-images.mjs :
 *   - format : equipe.jpg.webp / equipe.jpg.avif
 *   - tailles : equipe.jpg-768w.avif (si prop `widths`)
 */
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "eager" | "lazy";
  decoding?: "sync" | "async" | "auto";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  /** Largeurs responsives (px) pour srcset — ex. [480, 768, 1024] */
  widths?: number[];
}

const {
  src,
  alt,
  width,
  height,
  class: cls,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  sizes,
  widths,
} = Astro.props;

function buildSrcSet(format: "webp" | "avif", list?: number[]) {
  if (!list?.length) return `${src}.${format}`;

  const entries: string[] = [];
  let fullAdded = false;

  for (const w of list) {
    // La variante pleine taille est nommée src.ext, pas src-Nw.ext
    if (width && w >= width) {
      if (!fullAdded) {
        entries.push(`${src}.${format} ${width}w`);
        fullAdded = true;
      }
      continue;
    }
    entries.push(`${src}-${w}w.${format} ${w}w`);
  }

  if (!fullAdded && width && !list.includes(width)) {
    entries.push(`${src}.${format} ${width}w`);
  }

  return entries.join(", ");
}

const avifSrcSet = buildSrcSet("avif", widths);
const webpSrcSet = buildSrcSet("webp", widths);
---

<picture>
  <source type="image/avif" srcset={avifSrcSet} sizes={sizes} />
  <source type="image/webp" srcset={webpSrcSet} sizes={sizes} />
  <img
    src={widths?.length ? `${src}.webp` : src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={cls}
    sizes={sizes}
  />
</picture>
