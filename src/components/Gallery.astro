---
import Picture from "./Picture.astro";
import type { ImageAsset } from "@data/assets";

export interface Props {
  title: string;
  subtitle?: string;
  items: ImageAsset[];
  id?: string;
}

const { title, subtitle, items, id = "gallery" } = Astro.props;
---

<section class="section bg-neutral-50" aria-labelledby={`${id}-title`}>
  <div class="container-page">
    <div class="max-w-3xl">
      <h2 id={`${id}-title`} class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
        {title}
      </h2>
      {subtitle && <p class="mt-3 text-neutral-700">{subtitle}</p>}
    </div>

    <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {items.map((img, idx) => (
        <li class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm hover:shadow-lg transition-shadow group">
          <div class="aspect-[4/3] overflow-hidden bg-neutral-100">
            <Picture
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              loading={idx < 3 ? "eager" : "lazy"}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
