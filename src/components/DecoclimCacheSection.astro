---
import type { Locale } from "@i18n";
import type { PageColorScheme } from "@i18n";
import { getPageThemeClasses, pathFor } from "@i18n";
import { getDecoclimCacheContent } from "@i18n/content/decoclim-cache";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";

interface Props {
  locale: Locale;
  colorScheme?: PageColorScheme;
}

const { locale, colorScheme = "accent" } = Astro.props;
const content = getDecoclimCacheContent(locale);
const theme = getPageThemeClasses(colorScheme);
---

<section
  class="section bg-gradient-to-br from-neutral-900 via-neutral-800 to-neutral-900 text-white overflow-hidden"
  aria-labelledby="decoclim-cache-title"
>
  <div class="container-page relative">
    <div
      class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-accent-500/10 blur-3xl"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute -bottom-16 -left-16 h-56 w-56 rounded-full bg-white/5 blur-3xl"
      aria-hidden="true"
    />

    <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-x-14 lg:gap-y-8 items-center">
      <div class="order-2 lg:order-1">
        <span class="badge bg-white/10 text-neutral-200 border border-white/15">
          <Icon name="shield" size={12} />
          {content.badge}
        </span>
        <h2
          id="decoclim-cache-title"
          class="mt-4 font-display text-3xl md:text-4xl font-extrabold leading-tight text-white"
        >
          {content.title}
        </h2>

        <div class="mt-5 space-y-4 text-neutral-300 leading-relaxed">
          {content.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-8 grid grid-cols-3 gap-3">
          {content.highlights.map((h) => (
            <div class="rounded-xl bg-white/5 border border-white/10 px-3 py-4 text-center backdrop-blur-sm">
              <p class="font-display font-extrabold text-xl md:text-2xl text-accent-300">{h.value}</p>
              <p class="mt-1 text-xs text-neutral-400 leading-snug">{h.label}</p>
            </div>
          ))}
        </div>

        <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
          {content.benefits.map((benefit) => (
            <li class="flex items-start gap-2.5 text-sm text-neutral-200">
              <span
                class:list={[
                  "mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full",
                  theme.projectResultCheck,
                ]}
              >
                <Icon name="check" size={12} strokeWidth={3} />
              </span>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>

        <p class="mt-8 text-sm md:text-base text-neutral-300 leading-relaxed border-t border-white/10 pt-6">
          {content.closing}
        </p>

        <div class="mt-6">
          <a href={pathFor("contact", locale)} class="btn btn-accent">
            <Icon name="mail" size={18} />
            {content.cta}
          </a>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div
            class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-accent-400/25 via-transparent to-white/10 blur-2xl"
            aria-hidden="true"
          />
          <div class="relative rounded-[1.75rem] border border-white/10 bg-gradient-to-b from-white/10 to-white/5 p-4 shadow-2xl shadow-black/40 backdrop-blur-sm">
            <Picture
              src={content.image.src}
              alt={content.image.alt}
              width={content.image.width}
              height={content.image.height}
              class="relative w-full rounded-2xl bg-white object-contain"
              loading="lazy"
              sizes="(min-width: 1024px) 42vw, 88vw"
              widths={[384, 640, 768]}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
