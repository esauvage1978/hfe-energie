---
export interface Props {
  name:
    | "heat-pump"
    | "snowflake"
    | "flame"
    | "droplet"
    | "phone"
    | "mail"
    | "map-pin"
    | "clock"
    | "check"
    | "shield"
    | "leaf"
    | "euro"
    | "star"
    | "chevron-right"
    | "menu"
    | "close"
    | "arrow-right";
  class?: string;
  size?: number;
  strokeWidth?: number;
  label?: string;
}

const { name, class: cls = "", size = 24, strokeWidth = 2, label } = Astro.props;
const a11y = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true", focusable: "false" };
const common = {
  width: size,
  height: size,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": strokeWidth,
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
  class: cls,
  ...a11y,
};
---

{name === "heat-pump" && (
  <svg {...common}>
    <rect x="3" y="6" width="18" height="12" rx="2" />
    <circle cx="12" cy="12" r="3" />
    <path d="M12 9v6M9 12h6" />
    <path d="M5 3v2M19 3v2M5 19v2M19 19v2" />
  </svg>
)}

{name === "snowflake" && (
  <svg {...common}>
    <path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19" />
    <path d="M12 2l-2 3M12 2l2 3M12 22l-2-3M12 22l2-3M2 12l3-2M2 12l3 2M22 12l-3-2M22 12l-3 2" />
  </svg>
)}

{name === "flame" && (
  <svg {...common}>
    <path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z" />
  </svg>
)}

{name === "droplet" && (
  <svg {...common}>
    <path d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" />
  </svg>
)}

{name === "phone" && (
  <svg {...common}>
    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
  </svg>
)}

{name === "mail" && (
  <svg {...common}>
    <rect x="2" y="4" width="20" height="16" rx="2" />
    <path d="M22 7l-10 6L2 7" />
  </svg>
)}

{name === "map-pin" && (
  <svg {...common}>
    <path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 1116 0z" />
    <circle cx="12" cy="10" r="3" />
  </svg>
)}

{name === "clock" && (
  <svg {...common}>
    <circle cx="12" cy="12" r="10" />
    <path d="M12 6v6l4 2" />
  </svg>
)}

{name === "check" && (
  <svg {...common}>
    <path d="M20 6L9 17l-5-5" />
  </svg>
)}

{name === "shield" && (
  <svg {...common}>
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
    <path d="M9 12l2 2 4-4" />
  </svg>
)}

{name === "leaf" && (
  <svg {...common}>
    <path d="M11 20A7 7 0 014 13V6a14 14 0 0117 7 7 7 0 01-7 7z" />
    <path d="M2 22s4-6 9-6" />
  </svg>
)}

{name === "euro" && (
  <svg {...common}>
    <path d="M4 10h12M4 14h12" />
    <path d="M19 5.5A6 6 0 0014 4a8 8 0 100 16 6 6 0 005-1.5" />
  </svg>
)}

{name === "star" && (
  <svg {...common}>
    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14 2 9.27l6.91-1.01L12 2z" />
  </svg>
)}

{name === "chevron-right" && (
  <svg {...common}>
    <path d="M9 18l6-6-6-6" />
  </svg>
)}

{name === "arrow-right" && (
  <svg {...common}>
    <path d="M5 12h14M13 5l7 7-7 7" />
  </svg>
)}

{name === "menu" && (
  <svg {...common}>
    <path d="M3 12h18M3 6h18M3 18h18" />
  </svg>
)}

{name === "close" && (
  <svg {...common}>
    <path d="M18 6L6 18M6 6l12 12" />
  </svg>
)}
