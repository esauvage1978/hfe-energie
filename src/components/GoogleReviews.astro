---
import type { Locale } from "@i18n";
import {
  googleReviews,
  formatReviewDate,
  getSortedReviews,
  GOOGLE_REVIEW_URL,
} from "@data/google";
import { googleReviewsConfig } from "@data/google-reviews.config";
import { getHomeContent } from "@i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getHomeContent(locale);
const t = content.googleReviews;
const localeTag = locale === "en" ? "en" : "fr";
const updatedLabel = formatReviewDate(googleReviews.fetchedAt, localeTag);
const displayReviews = getSortedReviews(5);
const useWidget =
  googleReviewsConfig.mode === "widget" &&
  googleReviewsConfig.widgetIframeSrc.trim() !== "";

function renderStars(rating: number) {
  const full = Math.round(rating);
  return Array.from({ length: 5 }, (_, i) => i < full);
}

const starsOutOf = locale === "en" ? "out of 5" : "sur 5";
const mapsUri = googleReviews.googleMapsUri || GOOGLE_REVIEW_URL;
---

<section
  class="section bg-neutral-50"
  aria-labelledby="google-reviews-title"
  id="avis-google"
>
  <div class="container-page">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <span class="badge bg-accent-100 text-accent-800">{t.badge}</span>
        <h2
          id="google-reviews-title"
          class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900"
        >
          {t.title}
        </h2>
        <p class="mt-3 text-neutral-700">{t.subtitle}</p>
      </div>

      <div class="flex flex-col items-start gap-3 sm:items-end lg:items-end shrink-0">
        <div
          class="inline-flex items-center gap-3 rounded-2xl bg-white px-5 py-4 shadow-sm border border-neutral-200"
          aria-label={t.ratingAria(googleReviews.rating, googleReviews.userRatingCount)}
        >
          <svg class="h-8 w-8 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          <div>
            <p class="font-display text-2xl font-bold text-neutral-900 leading-none">
              {googleReviews.rating.toFixed(1)}
              <span class="text-lg font-semibold text-neutral-500">/5</span>
            </p>
            <p class="mt-1 text-sm text-neutral-600">
              {t.ratingCount(googleReviews.userRatingCount)}
            </p>
          </div>
        </div>
        <p class="text-xs text-neutral-500">
          {t.updated(updatedLabel)}
        </p>
      </div>
    </div>

    {
      useWidget ? (
        <div class="mt-10 overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
          <iframe
            src={googleReviewsConfig.widgetIframeSrc}
            title={t.widgetTitle}
            class="w-full border-0"
            style={`min-height: ${googleReviewsConfig.widgetMinHeight}px`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      ) : displayReviews.length === 0 ? (
        <p class="mt-10 rounded-2xl border border-neutral-200 bg-white px-6 py-8 text-center text-neutral-600">
          {t.emptyManual}
        </p>
      ) : (
        <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
          {displayReviews.map((review) => {
            const stars = renderStars(review.rating);
            const initial = review.author.trim().charAt(0).toUpperCase() || "?";
            return (
              <li>
                <article class="flex h-full flex-col rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex min-w-0 flex-1 items-center gap-3">
                      {review.photoUri ? (
                        <img
                          src={review.photoUri}
                          alt=""
                          width={40}
                          height={40}
                          class="h-10 w-10 shrink-0 rounded-full object-cover bg-neutral-100"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span
                          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-100 text-sm font-bold text-accent-800"
                          aria-hidden="true"
                        >
                          {initial}
                        </span>
                      )}
                      <div class="min-w-0">
                        {review.authorUri ? (
                          <a
                            href={review.authorUri}
                            class="font-semibold text-neutral-900 hover:text-accent-700 hover:underline underline-offset-2"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {review.author}
                          </a>
                        ) : (
                          <p class="font-semibold text-neutral-900">{review.author}</p>
                        )}
                      </div>
                    </div>
                    <div
                      class="flex shrink-0 gap-0.5"
                      aria-label={`${review.rating} ${starsOutOf}`}
                    >
                      {stars.map((filled) => (
                        <svg
                          class:list={[
                            "h-4 w-4",
                            filled ? "text-amber-400" : "text-neutral-200",
                          ]}
                          viewBox="0 0 20 20"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                  </div>
                  <p class="mt-2 text-xs text-neutral-500">{review.relativeTime}</p>
                  <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-neutral-700">
                    <p>« {review.text} »</p>
                  </blockquote>
                  <footer class="mt-4 text-xs text-neutral-500">{t.source}</footer>
                </article>
              </li>
            );
          })}
        </ul>
      )
    }

    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={googleReviews.reviewUrl}
        class="btn btn-google-review inline-flex items-center gap-2"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="h-[18px] w-[18px] shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
          ></path>
        </svg>
        {t.cta}
      </a>
      <a
        href={mapsUri}
        class="text-sm font-medium text-accent-700 hover:text-accent-800 underline-offset-2 hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.viewOnMaps}
      </a>
    </div>
  </div>
</section>
