---
export interface Props {
  items: Array<{ question: string; answer: string }>;
  idPrefix?: string;
  colorScheme?: "accent" | "primary" | "heat";
}

const { items, idPrefix = "faq", colorScheme = "accent" } = Astro.props;

const scheme = colorScheme === "heat" ? "accent" : colorScheme;

const openBorder =
  scheme === "primary" ? "open:border-primary-200" : "open:border-accent-200";
const iconClass =
  scheme === "primary"
    ? "bg-primary-50 text-primary-700"
    : "bg-accent-50 text-accent-700";
---

<div class="space-y-3">
  {
    items.map((item, idx) => {
      const id = `${idPrefix}-${idx}`;
      return (
        <details
          name={idPrefix}
          open={idx === 0 || undefined}
          class:list={[
            "group rounded-2xl border border-neutral-200 bg-white open:shadow-md transition-colors",
            openBorder,
          ]}
        >
          <summary
            id={`${id}-button`}
            class="flex list-none cursor-pointer items-center justify-between gap-4 px-5 py-4 min-h-[60px] text-left font-display text-base font-semibold text-neutral-900 md:px-6 md:py-5 md:text-lg [&::-webkit-details-marker]:hidden"
          >
            <span>{item.question}</span>
            <span
              class:list={[
                "flex h-8 w-8 shrink-0 items-center justify-center rounded-full transition-transform group-open:rotate-45",
                iconClass,
              ]}
              aria-hidden="true"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <div
            id={`${id}-panel`}
            role="region"
            aria-labelledby={`${id}-button`}
            class="px-5 pb-5 text-[15px] leading-relaxed text-neutral-700 md:px-6 md:pb-6"
          >
            {item.answer.split("\n").map((line, i) => (
              <p class={i > 0 ? "mt-2" : undefined}>{line}</p>
            ))}
          </div>
        </details>
      );
    })
  }
</div>
