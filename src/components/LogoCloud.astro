---
import Picture from "./Picture.astro";

export interface Props {
  title: string;
  subtitle?: string;
  items: ReadonlyArray<{ name: string; logo: string; width?: number; height?: number }>;
  variant?: "partners" | "clients";
}

const { title, subtitle, items, variant = "partners" } = Astro.props;
const grid =
  variant === "partners"
    ? "grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
    : "grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5";
---

<section class="section bg-white" aria-labelledby={`logocloud-${variant}-title`}>
  <div class="container-page">
    <div class="max-w-3xl text-center mx-auto">
      <h2 id={`logocloud-${variant}-title`} class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
        {title}
      </h2>
      {subtitle && <p class="mt-3 text-neutral-600">{subtitle}</p>}
    </div>

    <ul class={`mt-10 grid ${grid} gap-4 sm:gap-6 items-center`}>
      {items.map((item) => (
        <li class="flex items-center justify-center p-4 rounded-xl bg-neutral-50 border border-neutral-200 aspect-[3/2] grayscale-0 hover:grayscale-0 hover:bg-white hover:border-primary-200 transition-colors">
          <Picture
            src={item.logo}
            alt={`${item.name} - partenaire HFE Énergie`}
            width={item.width ?? 200}
            height={item.height ?? 80}
            class="max-h-12 sm:max-h-14 w-auto object-contain opacity-90"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
