---
import Picture from "./Picture.astro";

export interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  sectionClass?: string;
  items: ReadonlyArray<{ name: string; logo: string; width?: number; height?: number }>;
  /** partners / certifications : grille desktop, défilement mobile ; clients : défilement partout */
  variant?: "partners" | "clients" | "certifications";
}

const { title, subtitle, badge, sectionClass = "bg-white", items, variant = "partners" } = Astro.props;

const grid =
  variant === "partners"
    ? "grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
    : "grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5";

const listLayout =
  variant === "certifications"
    ? "mt-10 flex flex-wrap justify-center gap-4 sm:gap-6"
    : `mt-10 grid ${grid} gap-4 sm:gap-6 items-center`;

const listDesktopDisplay =
  variant === "certifications" ? "hidden sm:flex" : "hidden sm:grid";

const alwaysMarquee = variant === "clients";
const marqueeOnMobileOnly = variant === "partners" || variant === "certifications";

const carouselItems = [...items, ...items];

function logoAlt(name: string): string {
  if (variant === "clients") return `${name} - client Hecker & Frères Énergie (HFE)`;
  if (variant === "certifications") return `Certification ${name}`;
  return `${name} - partenaire Hecker & Frères Énergie (HFE)`;
}

const listItemClass =
  variant === "certifications"
    ? "flex items-center justify-center p-4 rounded-xl bg-white border border-neutral-200 aspect-square w-36 sm:w-40"
    : "flex items-center justify-center p-4 rounded-xl bg-neutral-50 border border-neutral-200 aspect-[3/2] grayscale-0 hover:grayscale-0 hover:bg-white hover:border-accent-200 transition-colors";

const pictureClass =
  variant === "certifications"
    ? "max-h-20 sm:max-h-24 w-auto object-contain"
    : "max-h-12 sm:max-h-14 w-auto object-contain opacity-90";
---

<section class:list={["section", sectionClass]} aria-labelledby={`logocloud-${variant}-title`}>
  <div class="container-page">
    <div class="max-w-3xl text-center mx-auto">
      {badge && <span class="badge bg-accent-100 text-accent-800">{badge}</span>}
      <h2
        id={`logocloud-${variant}-title`}
        class:list={["font-display text-3xl md:text-4xl font-extrabold text-neutral-900", badge && "mt-3"]}
      >
        {title}
      </h2>
      {subtitle && (
        <p class:list={["mt-3", variant === "certifications" ? "text-neutral-700" : "text-neutral-600"]}>
          {subtitle}
        </p>
      )}
      <slot name="subtitle" />
    </div>

    {(alwaysMarquee || marqueeOnMobileOnly) && (
      <div
        class:list={["logo-marquee mt-10", marqueeOnMobileOnly && "sm:hidden"]}
        aria-label={title}
        role="region"
      >
        <div class="logo-marquee-hints" aria-hidden="true">
          <span class="logo-marquee-hint logo-marquee-hint--left">‹</span>
          <span class="logo-marquee-hint logo-marquee-hint--right">›</span>
        </div>
        <div class="logo-marquee-track" data-marquee-track>
          {carouselItems.map((item, i) => (
            <div
              class:list={[
                "logo-marquee-item",
                variant === "certifications" && "logo-marquee-item--cert",
              ]}
              aria-hidden={i >= items.length ? "true" : undefined}
            >
              <Picture
                src={item.logo}
                alt={logoAlt(item.name)}
                width={item.width ?? 200}
                height={item.height ?? (variant === "certifications" ? 200 : 80)}
                class:list={[
                  pictureClass,
                  variant === "certifications" && "max-h-16 sm:max-h-16",
                ]}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      </div>
    )}

    {!alwaysMarquee && (
      <ul
        class:list={[
          listLayout,
          marqueeOnMobileOnly && listDesktopDisplay,
        ]}
      >
        {items.map((item) => (
          <li class={listItemClass}>
            <Picture
              src={item.logo}
              alt={logoAlt(item.name)}
              width={item.width ?? 200}
              height={item.height ?? (variant === "certifications" ? 200 : 80)}
              class={pictureClass}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .logo-marquee {
    overflow-x: auto;
    overflow-y: hidden;
    width: 100%;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    cursor: grab;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 6%,
      black 94%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 6%,
      black 94%,
      transparent 100%
    );
    position: relative;
  }

  .logo-marquee::-webkit-scrollbar {
    display: none;
  }

  .logo-marquee.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .logo-marquee-hints {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.5rem;
    z-index: 2;
    opacity: 0;
    transition: opacity 250ms ease;
  }

  /* Indication visuelle uniquement sur mobile */
  @media (max-width: 639px) {
    .logo-marquee-hints {
      opacity: 1;
    }
    .logo-marquee.hint-hidden .logo-marquee-hints {
      opacity: 0;
    }
  }

  .logo-marquee-hint {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    line-height: 1;
    font-weight: 800;
    color: var(--color-neutral-800);
    background: rgba(248, 250, 252, 0.86);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.10);
    transform: translateY(0);
  }

  .logo-marquee-hint--left {
    animation: hint-left 1.6s ease-in-out infinite;
  }
  .logo-marquee-hint--right {
    animation: hint-right 1.6s ease-in-out infinite;
  }

  @keyframes hint-left {
    0%, 100% { transform: translateX(0); opacity: 0.9; }
    50% { transform: translateX(-4px); opacity: 1; }
  }
  @keyframes hint-right {
    0%, 100% { transform: translateX(0); opacity: 0.9; }
    50% { transform: translateX(4px); opacity: 1; }
  }

  .logo-marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 1rem;
  }

  .logo-marquee-item {
    flex: 0 0 auto;
    width: 9rem;
    height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    background: var(--color-neutral-50);
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    transition: background-color 0.2s ease, border-color 0.2s ease,
      transform 0.2s ease;
  }

  .logo-marquee-item--cert {
    width: 7.5rem;
    height: 7.5rem;
    padding: 0.75rem;
    background: white;
  }

  .logo-marquee-item:hover {
    background: white;
    border-color: var(--color-accent-200);
    transform: translateY(-2px);
  }

  @media (min-width: 640px) {
    .logo-marquee-track {
      gap: 1.25rem;
    }
    .logo-marquee-item {
      width: 10.5rem;
      height: 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee {
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: thin;
    }
    .logo-marquee-track {
      /* rien : on reste sur le scroll natif */
    }
  }
</style>

<script>
  /**
   * Carrousel:
   * - Défilement auto par défaut
   * - Pause au touch / drag puis reprise après un court délai
   * - Drag souris (desktop) + doigt (mobile)
   * - Indice visuel mobile (gauche/droite) masqué après interaction
   */
  function setupLogoMarquee(container) {
    if (!container) return;

    const prefersReducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches ?? false;
    const isDesktop = window.matchMedia?.("(min-width: 640px)")?.matches ?? false;
    const isAutoEnabled = !prefersReducedMotion;

    const track = container.querySelector("[data-marquee-track]");

    let rafId = 0;
    let lastTs = 0;
    let pausedUntil = 0;
    const speedPxPerSec = isDesktop ? 22 : 16;

    function measure() {
      loopPoint = Math.floor((track?.scrollWidth ?? container.scrollWidth) / 2);
      containerWidth = container.clientWidth;
    }

    let loopPoint = 0;
    let containerWidth = 0;
    measure();

    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(() => measure());
      ro.observe(container);
      if (track) ro.observe(track);
    } else {
      window.addEventListener("resize", measure, { passive: true });
    }

    function tick(ts) {
      if (!isAutoEnabled) return;
      if (!lastTs) lastTs = ts;
      const dt = ts - lastTs;
      lastTs = ts;

      if (ts >= pausedUntil) {
        if (loopPoint <= containerWidth) {
          rafId = requestAnimationFrame(tick);
          return;
        }

        container.scrollLeft += (speedPxPerSec * dt) / 1000;
        if (loopPoint > 0 && container.scrollLeft >= loopPoint) {
          container.scrollLeft -= loopPoint;
        }
      }

      rafId = requestAnimationFrame(tick);
    }

    function pauseFor(ms) {
      const now = performance.now();
      pausedUntil = Math.max(pausedUntil, now + ms);
    }

    // Auto-start
    if (isAutoEnabled) {
      rafId = requestAnimationFrame(tick);
    }

    // Pause sur hover/focus (desktop)
    container.addEventListener("mouseenter", () => pauseFor(1500), { passive: true });
    container.addEventListener("focusin", () => pauseFor(1500), { passive: true });

    // Indice mobile: caché dès qu’on interagit
    const hideHint = () => container.classList.add("hint-hidden");
    container.addEventListener("scroll", hideHint, { passive: true, once: true });

    // Drag-to-scroll fiable (pointer events)
    let isDown = false;
    let startX = 0;
    let startScrollLeft = 0;

    const onPointerDown = (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      isDown = true;
      startX = e.clientX;
      startScrollLeft = container.scrollLeft;
      container.classList.add("is-dragging");
      hideHint();
      pauseFor(1800);
      try {
        container.setPointerCapture(e.pointerId);
      } catch {}
    };

    const onPointerMove = (e) => {
      if (!isDown) return;
      // Empêche la sélection / gestures parasites sur desktop
      e.preventDefault?.();
      const dx = e.clientX - startX;
      container.scrollLeft = startScrollLeft - dx;
    };

    const stop = () => {
      if (!isDown) return;
      isDown = false;
      container.classList.remove("is-dragging");
      pauseFor(1200);
    };

    container.addEventListener("pointerdown", onPointerDown, { passive: true });
    container.addEventListener("pointermove", onPointerMove, { passive: false });
    container.addEventListener("pointerup", stop, { passive: true });
    container.addEventListener("pointercancel", stop, { passive: true });
    container.addEventListener("pointerleave", stop, { passive: true });
  }

  function bootMarquees() {
    document.querySelectorAll(".logo-marquee").forEach((container) => {
      if (typeof IntersectionObserver === "undefined") {
        setupLogoMarquee(container);
        return;
      }
      const io = new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          setupLogoMarquee(container);
          observer.disconnect();
        },
        { rootMargin: "120px" },
      );
      io.observe(container);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootMarquees, { once: true });
  } else {
    bootMarquees();
  }
</script>
