---
import type { Locale } from "@i18n";
import { getHomeContent } from "@i18n";
import LogoCloud from "@components/LogoCloud.astro";
import { partenaires, certificationsLogos } from "@data/assets";

interface Props {
  locale: Locale;
  colorScheme?: "accent" | "primary" | "heat";
}

const { locale, colorScheme = "accent" } = Astro.props;
const home = getHomeContent(locale);
---

<LogoCloud
  title={home.partners.title}
  subtitle={home.partners.subtitle}
  items={partenaires}
  variant="partners"
  colorScheme={colorScheme}
/>

<LogoCloud
  badge={home.certificationsSection.badge}
  sectionClass="bg-neutral-50"
  title={home.certificationsSection.title}
  items={certificationsLogos}
  variant="certifications"
  colorScheme={colorScheme}
>
  <p slot="subtitle" class="mt-3 text-neutral-700">
    {home.certificationsSection.description}<strong>{home.certificationsSection.descriptionStrong}</strong>{home.certificationsSection.descriptionEnd}
  </p>
</LogoCloud>
