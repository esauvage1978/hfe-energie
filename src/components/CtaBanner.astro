---
import type { Locale } from "@i18n";
import { getUi, pathFor } from "@i18n";
import { site } from "@data/site";
import Icon from "./Icon.astro";

export interface Props {
  locale: Locale;
  title?: string;
  subtitle?: string;
  /** Numéro affiché (ex. ligne plomberie) — défaut : site.phone */
  phone?: string;
  phoneRaw?: string;
}

const { locale, title, subtitle, phone = site.phone, phoneRaw = site.phoneRaw } = Astro.props;
const { strings: t } = getUi(locale);
const bannerTitle = title ?? t.cta.defaultTitle;
const bannerSubtitle = subtitle ?? t.cta.defaultSubtitle;
---

<section class="section" aria-labelledby="cta-banner-title">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-accent-700 via-accent-800 to-accent-900 p-8 md:p-12 text-white shadow-xl">
      <div class="absolute top-0 right-0 w-64 h-64 bg-accent-400/30 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-72 h-72 bg-accent-500/20 rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl pointer-events-none"></div>

      <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-2xl">
          <span class="badge bg-white/15 text-white border border-white/20">
            <Icon name="leaf" size={12} />
            {t.cta.badge}
          </span>
          <h2 id="cta-banner-title" class="mt-3 text-2xl md:text-4xl font-display font-extrabold text-white">
            {bannerTitle}
          </h2>
          <p class="mt-3 text-base md:text-lg text-accent-100">{bannerSubtitle}</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href={`tel:${phoneRaw}`} class="btn bg-white text-accent-800 hover:bg-accent-50">
            <Icon name="phone" size={18} />
            {phone}
          </a>
          <a href={pathFor("contact", locale)} class="btn bg-transparent text-white border-2 border-white/40 hover:bg-white/10">
            <Icon name="mail" size={18} />
            {t.cta.onlineRequest}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
