---
import { site } from "@data/site";
import Icon from "./Icon.astro";

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Besoin d'un devis pompe à chaleur ?",
  subtitle = "Étude personnalisée gratuite, sans engagement. Réponse sous 24h.",
} = Astro.props;
---

<section class="section" aria-labelledby="cta-banner-title">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary-700 via-primary-800 to-primary-900 p-8 md:p-12 text-white shadow-xl">
      <div class="absolute top-0 right-0 w-64 h-64 bg-accent-500/20 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-72 h-72 bg-primary-400/20 rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl pointer-events-none"></div>

      <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-2xl">
          <span class="badge bg-white/15 text-white border border-white/20">
            <Icon name="leaf" size={12} />
            Devis gratuit
          </span>
          <h2 id="cta-banner-title" class="mt-3 text-2xl md:text-4xl font-display font-extrabold text-white">
            {title}
          </h2>
          <p class="mt-3 text-base md:text-lg text-primary-100">
            {subtitle}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href={`tel:${site.phoneRaw}`} class="btn btn-accent">
            <Icon name="phone" size={18} />
            {site.phone}
          </a>
          <a href="/contact" class="btn bg-white text-primary-800 hover:bg-primary-50">
            <Icon name="mail" size={18} />
            Demande en ligne
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
