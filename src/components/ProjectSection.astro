---
import type { Locale, PageColorScheme } from "@i18n";
import { getPageThemeClasses } from "@i18n";
import { getProjectsUi } from "@i18n/content/projects-shared";
import type { Project } from "@i18n/content/projects-shared";
import Icon from "./Icon.astro";
import ProjectBeforeAfter from "./ProjectBeforeAfter.tsx";
import ProjectGallery from "./ProjectGallery.tsx";
import ProjectInstallCta from "./ProjectInstallCta.astro";

interface Props {
  locale: Locale;
  project: Project;
  index: number;
  projectLabel: string;
  eagerGallery?: boolean;
  showInstallCta?: boolean;
  colorScheme?: PageColorScheme;
}

const { locale, project, index, projectLabel, eagerGallery = false, showInstallCta = true, colorScheme = "accent" } = Astro.props;
const ui = getProjectsUi(locale);
const theme = getPageThemeClasses(colorScheme);
---

<section
  id={project.slug}
  class="section-project bg-neutral-50"
  aria-labelledby={`project-${index}-title`}
>
  <div class="container-page">
    <div class="flex items-center gap-3 mb-8">
      <span class:list={[
        "flex items-center justify-center w-10 h-10 rounded-full text-white font-display font-extrabold text-lg shadow-md",
        theme.projectIndexBadge,
      ]}>
        {index + 1}
      </span>
      <span class:list={["text-sm font-semibold uppercase tracking-wider", theme.projectIndexLabel]}>
        {projectLabel} {index + 1}
      </span>
    </div>

    <h2
      id={`project-${index}-title`}
      class="font-display font-extrabold text-2xl md:text-3xl text-neutral-900 leading-tight max-w-4xl"
    >
      {project.title}
    </h2>
    <p class:list={["mt-2 text-base font-medium max-w-3xl", theme.projectSubtitle]}>{project.subtitle}</p>

    <!-- Le chantier en chiffres -->
    <div class="mt-10">
      <h3 class:list={[
        "font-display font-extrabold text-sm uppercase tracking-wider border-b-2 pb-2 inline-block",
        theme.projectStatsHeading,
      ]}>
        {ui.statsTitle}
      </h3>
      <div class="mt-5 grid grid-cols-2 lg:grid-cols-4 gap-4">
        {project.stats.map((stat) => (
          <div class="rounded-xl bg-white border border-neutral-200 p-4 md:p-5 shadow-sm">
            <div class:list={[
              "w-10 h-10 rounded-lg flex items-center justify-center mb-3",
              theme.projectStatsIconBox,
            ]}>
              <Icon name={stat.icon} size={22} />
            </div>
            <p class="font-display font-extrabold text-2xl md:text-3xl text-neutral-900">{stat.value}</p>
            <p class="mt-1 text-xs md:text-sm text-neutral-500 leading-snug">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Avant / Après + Le résultat -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
      <ProjectBeforeAfter
        client:load
        colorScheme={colorScheme}
        title={project.beforeAfter.before?.image
          ? ui.beforeAfterTitle
          : project.beforeAfter.after?.image || project.beforeAfter.afters?.some((s) => s.image)
            ? ui.installPhotosTitle
            : ui.resultsTitle}
        before={project.beforeAfter.before?.image && {
          caption: project.beforeAfter.before.caption,
          badge: ui.beforeLabel,
          image: project.beforeAfter.before.image,
        }}
        after={project.beforeAfter.after && {
          caption: project.beforeAfter.after.caption,
          badge: project.beforeAfter.before?.image ? ui.afterLabel : "",
          image: project.beforeAfter.after.image,
        }}
        afters={project.beforeAfter.afters?.map((side) => ({
          caption: side.caption,
          badge: project.beforeAfter.before?.image ? ui.afterLabel : "",
          image: side.image,
        }))}
        closeLabel={ui.lightboxClose}
        prevLabel={ui.lightboxPrev}
        nextLabel={ui.lightboxNext}
      />

      <div class="rounded-2xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm">
        <h3 class:list={["font-display font-extrabold text-sm uppercase tracking-wider mb-4", theme.projectResultsHeading]}>
          {ui.resultsTitle}
        </h3>
        <ul class="space-y-4">
          {project.results.map((r) => (
            <li class="flex items-start gap-3">
              <span class:list={[
                "w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5",
                theme.projectResultCheck,
              ]}>
                <Icon name="check" size={14} strokeWidth={3} />
              </span>
              <div>
                <p class="font-semibold text-neutral-900 text-sm md:text-base">{r.title}</p>
                <p class="mt-0.5 text-sm text-neutral-600 leading-relaxed">{r.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- À propos + galerie -->
    <div class="mt-8 rounded-2xl bg-white border border-neutral-200 p-5 md:p-8 shadow-sm">
      <h3 class:list={["font-display font-extrabold text-sm uppercase tracking-wider mb-5", theme.projectAboutHeading]}>
        {ui.aboutTitle}
      </h3>
      <div class:list={["grid gap-8 lg:gap-12 items-start", project.images.length > 0 ? "grid-cols-1 lg:grid-cols-2" : "grid-cols-1 max-w-3xl"]}>
        <div>
          <div class="space-y-4 text-neutral-700 leading-relaxed">
            {project.description.map((p) => <p>{p}</p>)}
          </div>

          {project.sections && project.sections.length > 0 && (
            <div class="mt-8 space-y-8">
              {project.sections.map((section) => (
                <article>
                  <h4 class="font-display font-bold text-lg text-neutral-900">{section.title}</h4>
                  {section.paragraphs && (
                    <div class="mt-3 space-y-3">
                      {section.paragraphs.map((p) => <p>{p}</p>)}
                    </div>
                  )}
                  {section.items && (
                    <ul class="mt-3 space-y-2">
                      {section.items.map((item) => (
                        <li class="flex items-start gap-2.5 text-sm md:text-base">
                          <span class:list={["mt-2 w-1.5 h-1.5 rounded-full shrink-0", theme.bullet]} aria-hidden="true" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {section.afterItems && (
                    <div class="mt-3 space-y-3">
                      {section.afterItems.map((p) => <p>{p}</p>)}
                    </div>
                  )}
                </article>
              ))}
            </div>
          )}

          {project.brands && project.brands.length > 0 && (
            <div class="mt-6 flex flex-col gap-3">
              <div class="flex flex-wrap items-center gap-3">
                {project.brands.map((brand) => (
                  <div class="shrink-0 rounded-xl border border-neutral-200 bg-neutral-50 px-5 py-3">
                    <img
                      src={brand.logo}
                      alt={brand.name}
                      width={140}
                      height={48}
                      loading="lazy"
                      class="h-10 w-auto object-contain"
                    />
                  </div>
                ))}
              </div>
              <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                {project.brands.flatMap((brand) => brand.warranties).map((warranty) => (
                  <div class:list={["shrink-0 rounded-xl border-2 px-3 py-2.5 sm:px-4 sm:py-3", theme.projectWarrantyBox]}>
                    <p class:list={["text-[10px] sm:text-xs font-bold uppercase tracking-wide whitespace-nowrap", theme.projectWarrantyText]}>{warranty}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {project.images.length > 0 && (
          <div>
            <p class="text-sm font-semibold text-neutral-500 mb-3">{ui.galleryTitle}</p>
            <ProjectGallery
              images={[...project.images]}
              locale={locale}
              eager={eagerGallery}
              colorScheme={colorScheme}
              closeLabel={ui.lightboxClose}
              prevLabel={ui.lightboxPrev}
              nextLabel={ui.lightboxNext}
              client:load
            />
          </div>
        )}
      </div>
    </div>

    {showInstallCta && <ProjectInstallCta locale={locale} colorScheme={colorScheme} />}
  </div>
</section>
