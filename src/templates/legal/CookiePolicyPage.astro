---
import type { Locale } from "@i18n";
import { pathFor } from "@i18n";
import LegalLayout from "@layouts/LegalLayout.astro";
import { legal } from "@data/legal";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === "en";

const title = isEn ? "Cookie policy" : "Politique des cookies";
const description = isEn
  ? "HFE Énergie cookie policy: types of cookies, retention periods and how to manage them in your browser."
  : "Politique des cookies du site HFE Énergie : nature des cookies, durée de conservation et méthodes pour les gérer dans votre navigateur.";

const updatedAt = isEn ? "May 16, 2026" : legal.updatedAt.cookies;
---

<LegalLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={pathFor("cookies", locale)}
  updatedAt={updatedAt}
>
  {isEn ? (
    <>
      <p>
        This policy aims to inform you about the use of cookies and other trackers on the{" "}
        <strong>{legal.company.name}</strong> website. It complies with the guidelines and recommendations of
        the <strong>French Data Protection Authority (CNIL)</strong> on cookies (Deliberation No. 2020-091 of 17
        September 2020) and the GDPR.
      </p>

      <h2>1. What is a cookie?</h2>
      <p>
        A cookie is a small text file placed on your device (computer, smartphone, tablet) by your browser when
        you visit a website. It is used, among other things, to remember information about your browsing and to
        provide personalised features.
      </p>
      <p>Cookies are classified into several categories according to their purpose:</p>
      <ul>
        <li><strong>Strictly necessary cookies</strong> for the operation of the site (exempt from consent)</li>
        <li><strong>Audience measurement cookies</strong> (anonymised or requiring consent)</li>
        <li><strong>Functionality cookies</strong> (user preferences)</li>
        <li><strong>Advertising / marketing cookies</strong> (requiring explicit consent)</li>
        <li><strong>Social network cookies</strong> (requiring explicit consent)</li>
      </ul>

      <h2>2. Cookies used on the {legal.company.name} website</h2>
      <p>
        <strong>{legal.company.legalName} has chosen to minimise the use of cookies</strong> in order to best
        respect your privacy. Our website uses <strong>no advertising cookies</strong> and{" "}
        <strong>no marketing tracking tools</strong>.
      </p>

      <h3>2.1 Strictly necessary cookies</h3>
      <p>
        These cookies are essential for the proper functioning of the website. They do not require your prior
        consent (Article 82 of the French Data Protection Act).
      </p>
      <table class="w-full text-sm border-collapse my-4">
        <thead>
          <tr class="bg-neutral-100">
            <th class="text-left p-3 border border-neutral-200">Cookie</th>
            <th class="text-left p-3 border border-neutral-200">Purpose</th>
            <th class="text-left p-3 border border-neutral-200">Duration</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-3 border border-neutral-200">Technical preferences</td>
            <td class="p-3 border border-neutral-200">Remembering your display preferences</td>
            <td class="p-3 border border-neutral-200">Session</td>
          </tr>
          <tr>
            <td class="p-3 border border-neutral-200">Security</td>
            <td class="p-3 border border-neutral-200">Protection against attacks (CSRF, XSS)</td>
            <td class="p-3 border border-neutral-200">Session</td>
          </tr>
        </tbody>
      </table>

      <h3>2.2 Third-party cookies from integrated services</h3>
      <p>Our website integrates certain third-party services that may place their own cookies:</p>
      <table class="w-full text-sm border-collapse my-4">
        <thead>
          <tr class="bg-neutral-100">
            <th class="text-left p-3 border border-neutral-200">Service</th>
            <th class="text-left p-3 border border-neutral-200">Purpose</th>
            <th class="text-left p-3 border border-neutral-200">Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-3 border border-neutral-200">OpenStreetMap (Contact page map)</td>
            <td class="p-3 border border-neutral-200">Displaying the location map</td>
            <td class="p-3 border border-neutral-200">No tracking cookies</td>
          </tr>
          <tr>
            <td class="p-3 border border-neutral-200">Google Fonts</td>
            <td class="p-3 border border-neutral-200">Displaying Inter and Plus Jakarta Sans fonts</td>
            <td class="p-3 border border-neutral-200">No tracking cookies</td>
          </tr>
        </tbody>
      </table>
      <p>
        For more information on the privacy policies of these services, we invite you to consult their respective
        websites directly.
      </p>

      <h3>2.3 What we do NOT use</h3>
      <ul>
        <li>No advertising or retargeting cookies</li>
        <li>No audience measurement tools such as Google Analytics, Matomo, Hotjar, etc.</li>
        <li>No social network pixels (Facebook Pixel, LinkedIn Insight, etc.)</li>
        <li>No tag management solutions (Google Tag Manager, Tealium, etc.)</li>
        <li>No digital fingerprinting</li>
      </ul>

      <h2>3. Managing cookies via your browser</h2>
      <p>
        You may configure your browser at any time to accept, refuse or delete cookies, either globally or on a
        cookie-by-cookie basis. Here is how to proceed depending on your browser:
      </p>
      <ul>
        <li>
          <strong>Google Chrome</strong>:
          <a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener noreferrer">
            Manage cookies in Chrome
          </a>
        </li>
        <li>
          <strong>Mozilla Firefox</strong>:
          <a href="https://support.mozilla.org/en-US/kb/enhanced-tracking-protection-firefox-desktop" target="_blank" rel="noopener noreferrer">
            Enhanced Tracking Protection
          </a>
        </li>
        <li>
          <strong>Safari (macOS / iOS)</strong>:
          <a href="https://support.apple.com/guide/safari/sfri11471/mac" target="_blank" rel="noopener noreferrer">
            Manage cookies in Safari
          </a>
        </li>
        <li>
          <strong>Microsoft Edge</strong>:
          <a href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09" target="_blank" rel="noopener noreferrer">
            Delete cookies in Edge
          </a>
        </li>
        <li>
          <strong>Opera</strong>:
          <a href="https://help.opera.com/en/latest/web-preferences/" target="_blank" rel="noopener noreferrer">
            Opera web preferences
          </a>
        </li>
      </ul>
      <p>
        Refusing strictly necessary cookies may impair your experience on the site (loss of preferences,
        unavailable features).
      </p>

      <h2>4. Tools provided by the CNIL</h2>
      <p>The CNIL provides several resources to help you manage cookies:</p>
      <ul>
        <li>
          <a href="https://www.cnil.fr/en/cookies-and-other-tracking-devices-cnil-publishes-new-guidelines-and-recommendation" target="_blank" rel="noopener noreferrer">
            Cookies and trackers: what does the law say?
          </a>
        </li>
        <li>
          <a href="https://www.cnil.fr/fr/cookies-et-autres-traceurs/comment-se-proteger/maitriser-votre-navigateur" target="_blank" rel="noopener noreferrer">
            Master your browser (French)
          </a>
        </li>
      </ul>

      <h2>5. Changes to this cookie policy</h2>
      <p>
        {legal.company.legalName} reserves the right to amend this policy at any time to take account of
        legislative, case-law or technical developments. Any change will be reflected in an updated date at the
        top of this page.
      </p>

      <h2>6. Contact</h2>
      <p>For any questions regarding the use of cookies on our website:</p>
      <ul>
        <li>By email: <a href={`mailto:${legal.company.email}`}>{legal.company.email}</a></li>
        <li>By post: {legal.company.legalName} - {legal.company.address}</li>
      </ul>
    </>
  ) : (
    <>
      <p>
        La présente politique a pour objet de vous informer sur l'utilisation de cookies et autres traceurs
        sur le site <strong>{legal.company.name}</strong>. Elle est conforme aux lignes directrices et
        recommandations de la <strong>Commission Nationale de l'Informatique et des Libertés (CNIL)</strong>
        en matière de cookies (délibération n° 2020-091 du 17 septembre 2020) et au RGPD.
      </p>

      <h2>1. Qu'est-ce qu'un cookie ?</h2>
      <p>
        Un cookie est un petit fichier texte déposé sur votre terminal (ordinateur, smartphone, tablette)
        par le navigateur lors de la visite d'un site web. Il permet notamment de mémoriser des
        informations sur votre navigation et de proposer des fonctionnalités personnalisées.
      </p>
      <p>Les cookies sont classés en plusieurs catégories selon leur finalité :</p>
      <ul>
        <li><strong>Cookies strictement nécessaires</strong> au fonctionnement du site (exemptés de consentement)</li>
        <li><strong>Cookies de mesure d'audience</strong> (anonymisés ou nécessitant consentement)</li>
        <li><strong>Cookies de fonctionnalité</strong> (préférences utilisateur)</li>
        <li><strong>Cookies publicitaires / marketing</strong> (nécessitant consentement explicite)</li>
        <li><strong>Cookies de réseaux sociaux</strong> (nécessitant consentement explicite)</li>
      </ul>

      <h2>2. Cookies utilisés sur le site {legal.company.name}</h2>
      <p>
        <strong>{legal.company.legalName} a fait le choix de minimiser l'utilisation des cookies</strong>
        afin de respecter au mieux votre vie privée. Notre site n'utilise <strong>aucun cookie
        publicitaire</strong> ni <strong>aucun outil de pistage marketing</strong>.
      </p>

      <h3>2.1 Cookies strictement nécessaires</h3>
      <p>
        Ces cookies sont indispensables au bon fonctionnement du site. Ils ne nécessitent pas votre
        consentement préalable (article 82 de la loi Informatique et Libertés).
      </p>
      <table class="w-full text-sm border-collapse my-4">
        <thead>
          <tr class="bg-neutral-100">
            <th class="text-left p-3 border border-neutral-200">Cookie</th>
            <th class="text-left p-3 border border-neutral-200">Finalité</th>
            <th class="text-left p-3 border border-neutral-200">Durée</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-3 border border-neutral-200">Préférences techniques</td>
            <td class="p-3 border border-neutral-200">Mémorisation de vos préférences d'affichage</td>
            <td class="p-3 border border-neutral-200">Session</td>
          </tr>
          <tr>
            <td class="p-3 border border-neutral-200">Sécurité</td>
            <td class="p-3 border border-neutral-200">Protection contre les attaques (CSRF, XSS)</td>
            <td class="p-3 border border-neutral-200">Session</td>
          </tr>
        </tbody>
      </table>

      <h3>2.2 Cookies tiers déposés par des services intégrés</h3>
      <p>
        Notre site intègre certains services tiers qui peuvent être amenés à déposer leurs propres cookies :
      </p>
      <table class="w-full text-sm border-collapse my-4">
        <thead>
          <tr class="bg-neutral-100">
            <th class="text-left p-3 border border-neutral-200">Service</th>
            <th class="text-left p-3 border border-neutral-200">Finalité</th>
            <th class="text-left p-3 border border-neutral-200">Statut</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-3 border border-neutral-200">OpenStreetMap (carte de la page Contact)</td>
            <td class="p-3 border border-neutral-200">Affichage de la carte de localisation</td>
            <td class="p-3 border border-neutral-200">Aucun cookie de pistage</td>
          </tr>
          <tr>
            <td class="p-3 border border-neutral-200">Google Fonts</td>
            <td class="p-3 border border-neutral-200">Affichage des polices Inter et Plus Jakarta Sans</td>
            <td class="p-3 border border-neutral-200">Aucun cookie de pistage</td>
          </tr>
        </tbody>
      </table>
      <p>
        Pour plus d'informations sur la politique de confidentialité de ces services, nous vous invitons à
        consulter directement leurs sites respectifs.
      </p>

      <h3>2.3 Ce que nous N'utilisons PAS</h3>
      <ul>
        <li>Aucun cookie publicitaire ou de retargeting</li>
        <li>Aucun outil de mesure d'audience type Google Analytics, Matomo, Hotjar, etc.</li>
        <li>Aucun pixel de réseau social (Facebook Pixel, LinkedIn Insight, etc.)</li>
        <li>Aucune solution de tag management (Google Tag Manager, Tealium, etc.)</li>
        <li>Aucune empreinte numérique (fingerprinting)</li>
      </ul>

      <h2>3. Gestion des cookies via votre navigateur</h2>
      <p>
        Vous pouvez à tout moment configurer votre navigateur pour accepter, refuser ou supprimer les
        cookies, soit globalement, soit cookie par cookie. Voici comment procéder selon votre navigateur :
      </p>
      <ul>
        <li>
          <strong>Google Chrome</strong> :
          <a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener noreferrer">
            Gérer les cookies dans Chrome
          </a>
        </li>
        <li>
          <strong>Mozilla Firefox</strong> :
          <a href="https://support.mozilla.org/fr/kb/protection-renforcee-contre-pistage-firefox-ordinateur" target="_blank" rel="noopener noreferrer">
            Protection renforcée contre le pistage
          </a>
        </li>
        <li>
          <strong>Safari (macOS / iOS)</strong> :
          <a href="https://support.apple.com/fr-fr/guide/safari/sfri11471/mac" target="_blank" rel="noopener noreferrer">
            Gérer les cookies dans Safari
          </a>
        </li>
        <li>
          <strong>Microsoft Edge</strong> :
          <a href="https://support.microsoft.com/fr-fr/microsoft-edge/supprimer-les-cookies-dans-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09" target="_blank" rel="noopener noreferrer">
            Supprimer les cookies dans Edge
          </a>
        </li>
        <li>
          <strong>Opera</strong> :
          <a href="https://help.opera.com/fr/latest/web-preferences/" target="_blank" rel="noopener noreferrer">
            Préférences web Opera
          </a>
        </li>
      </ul>
      <p>
        Le refus des cookies strictement nécessaires peut entraîner une dégradation de votre expérience
        sur le site (perte de préférences, fonctionnalités indisponibles).
      </p>

      <h2>4. Outils de gestion fournis par la CNIL</h2>
      <p>La CNIL met à disposition plusieurs ressources pour vous aider à gérer vos cookies :</p>
      <ul>
        <li>
          <a href="https://www.cnil.fr/fr/cookies-et-traceurs-que-dit-la-loi" target="_blank" rel="noopener noreferrer">
            Cookies et traceurs : que dit la loi ?
          </a>
        </li>
        <li>
          <a href="https://www.cnil.fr/fr/cookies-et-autres-traceurs/comment-se-proteger/maitriser-votre-navigateur" target="_blank" rel="noopener noreferrer">
            Maîtriser votre navigateur
          </a>
        </li>
      </ul>

      <h2>5. Évolution de la politique des cookies</h2>
      <p>
        {legal.company.legalName} se réserve le droit d'adapter cette politique à tout moment pour tenir
        compte des évolutions législatives, jurisprudentielles ou techniques. Toute modification fera
        l'objet d'une mise à jour datée en haut de cette page.
      </p>

      <h2>6. Contact</h2>
      <p>Pour toute question relative à l'utilisation des cookies sur notre site :</p>
      <ul>
        <li>Par e-mail : <a href={`mailto:${legal.company.email}`}>{legal.company.email}</a></li>
        <li>Par courrier : {legal.company.legalName} - {legal.company.address}</li>
      </ul>
    </>
  )}
</LegalLayout>
