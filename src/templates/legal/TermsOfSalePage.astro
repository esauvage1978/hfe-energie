---
import type { Locale } from "@i18n";
import { pathFor } from "@i18n";
import LegalLayout from "@layouts/LegalLayout.astro";
import { legal } from "@data/legal";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === "en";

const title = isEn ? "Terms of sale" : "Conditions Générales de Vente (CGV)";
const description = isEn
  ? "HFE Énergie terms of sale: quotes, payment terms, ten-year and two-year guarantees, right of withdrawal and consumer mediation."
  : "CGV HFE Énergie : devis, modalités de paiement, garantie décennale et biennale, droit de rétractation, médiation de la consommation.";

const privacyPath = pathFor("privacy", locale);
const updatedAt = isEn ? "May 16, 2026" : legal.updatedAt.cgv;
---

<LegalLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={pathFor("termsOfSale", locale)}
  updatedAt={updatedAt}
>
  {isEn ? (
    <>
      <p>
        These General Terms of Sale (hereinafter "GTS") govern the contractual relationship between{" "}
        <strong>{legal.company.legalName}</strong> ({legal.company.name}), {legal.company.legalForm} with share
        capital of {legal.company.capital}, registered with the trade register of {legal.company.rcs}, whose
        registered office is at {legal.company.address} (hereinafter "the Service Provider" or "{legal.company.name}"),
        and any natural or legal person using its services (hereinafter "the Customer").
      </p>

      <h2>Article 1 - Purpose</h2>
      <p>These GTS define the conditions under which {legal.company.name} provides its services:</p>
      <ul>
        <li>
          Design, installation, commissioning, maintenance and repair of heat pumps (air-to-water, air-to-air,
          geothermal, thermodynamic water heaters)
        </li>
        <li>
          Design, installation, commissioning, maintenance and repair of reversible air-conditioning systems
          (mono-split, multi-split, ducted, cassette)
        </li>
        <li>Installation, replacement and maintenance of boilers (gas, oil, hybrid, condensing)</li>
        <li>Plumbing and sanitary works</li>
        <li>Preparation of energy renovation grant applications (MaPrimeRénov', CEE)</li>
      </ul>
      <p>Any order implies the Customer's unreserved acceptance of these GTS.</p>

      <h2>Article 2 - Quotes</h2>
      <p>
        Every quote is prepared <strong>free of charge, in writing</strong> (paper or email), following a
        technical visit to the Customer's home or premises. The quote specifies:
      </p>
      <ul>
        <li>The precise nature of the services and equipment proposed (brand, model, output)</li>
        <li>Prices excluding and including tax, distinguishing supply and installation</li>
        <li>The applicable VAT rate (5.5%, 10% or 20% as applicable)</li>
        <li>An estimate of available financial grants (MaPrimeRénov', CEE)</li>
        <li>Terms and deadlines for the work</li>
        <li>The validity period of the quote</li>
      </ul>
      <p>
        Unless otherwise stated, <strong>the quote is valid for 30 days</strong> from its date of issue. Beyond
        that, {legal.company.name} reserves the right to revise its prices.
      </p>

      <h2>Article 3 - Formation of the contract</h2>
      <p>The contract is formed on the date {legal.company.name} receives the quote:</p>
      <ul>
        <li>Dated and signed by the Customer with the handwritten words "<em>Approved for agreement</em>"</li>
        <li>Accompanied by payment of the deposit provided for (see Article 6)</li>
      </ul>
      <p>
        The signed quote constitutes the contract binding the parties. No amendment may be made without the
        written agreement of both parties.
      </p>

      <h2>Article 4 - Right of withdrawal</h2>
      <p>
        In accordance with Articles L.221-18 et seq. of the French Consumer Code, consumer Customers benefit
        from a <strong>14-day withdrawal period</strong> from the date of signature of the contract, where the
        contract is concluded away from business premises (at the Customer's home or at a distance).
      </p>
      <p>
        To exercise this right, the Customer may use the withdrawal form attached to the quote or notify their
        decision unambiguously to {legal.company.email}, by post to {legal.company.address}, or by any other
        written means.
      </p>

      <h3>Waiver of the right of withdrawal</h3>
      <p>
        In accordance with Article L.221-25 of the French Consumer Code, the Customer may expressly waive their
        right of withdrawal in cases of <strong>urgency</strong> (breakdown requiring rapid intervention, winter
        shutdown, etc.). This waiver must be handwritten, dated and signed by the Customer.
      </p>

      <h3>Withdrawal form template</h3>
      <p class="bg-neutral-50 p-4 rounded-lg border border-neutral-200 text-sm">
        To the attention of {legal.company.legalName}, {legal.company.address}, email: {legal.company.email}<br /><br />
        I hereby notify you of my withdrawal from the contract for the following service:
        [identification of the service]<br /><br />
        Ordered on: [date]<br />
        Consumer's name: [first and last name]<br />
        Consumer's address: [address]<br /><br />
        Consumer's signature (paper notification only):<br />
        Date:
      </p>

      <h2>Article 5 - Prices</h2>
      <p>
        Prices are expressed in euros, excluding tax (HT) and all taxes included (TTC). VAT applicable is that
        in force on the invoice date. The applicable rates are:
      </p>
      <ul>
        <li>
          <strong>5.5%</strong> on energy efficiency improvement works in dwellings over 2 years old (heat pump,
          thermodynamic water heater, etc.)
        </li>
        <li>
          <strong>10%</strong> on maintenance, repair and compliance works in dwellings over 2 years old
        </li>
        <li>
          <strong>20%</strong> on other services (new dwellings, commercial premises, etc.)
        </li>
      </ul>
      <p>
        The Customer undertakes to provide on honour the information required for application of the reduced
        rate (completion date of the dwelling, residential use, etc.). In the event of challenge by the tax
        authorities, the VAT differential shall be payable by the Customer.
      </p>
      <p>
        Prices include supply of equipment, labour, travel to the site and commissioning. Unless otherwise
        stated, the following are not included: structural works, electrical connections to the distribution
        board, removal of specific rubble, structural reinforcement.
      </p>

      <h2>Article 6 - Payment terms</h2>
      <p>Unless otherwise agreed, payment is made according to the following schedule:</p>
      <ul>
        <li><strong>30%</strong> on order, as a deposit</li>
        <li><strong>40%</strong> when work commences</li>
        <li><strong>30%</strong> on acceptance of works, within 8 days of the invoice</li>
      </ul>
      <p>
        <strong>Accepted means of payment</strong>: bank transfer, cheque, cash (within the legal limit of €1,000
        for individual customers who are French tax residents), bank card.
      </p>
      <p>
        In the event of late payment, <strong>late payment penalties</strong> shall apply automatically at the
        legal rate plus 3 points (and at least 3 times the legal interest rate for professionals), from the
        day after the due date, without reminder being necessary. For professionals, a <strong>fixed recovery
        indemnity of €40</strong> shall also be due (Article D.441-5 of the French Commercial Code).
      </p>

      <h2>Article 7 - Intervention deadlines</h2>
      <p>
        Intervention deadlines are given for guidance in the quote. {legal.company.name} undertakes to meet these
        deadlines where possible. Any delay shall not engage the Service Provider's liability in the event of
        force majeure, unavailability of the Customer, modification of the project during the works or delay in
        supply from suppliers.
      </p>

      <h2>Article 8 - Customer obligations</h2>
      <p>The Customer undertakes to:</p>
      <ul>
        <li>Allow free access to the premises on the agreed day</li>
        <li>Provide the electricity and water necessary for execution of the works</li>
        <li>Protect their property and furniture in the work area</li>
        <li>Provide all information useful for the intervention (plans, electrical diagrams, etc.)</li>
        <li>Pay amounts due on the agreed dates</li>
      </ul>

      <h2>Article 9 - Acceptance of works</h2>
      <p>
        On completion of the works, an <strong>acceptance report</strong> is drawn up jointly between the
        Customer and {legal.company.name}. It records any reservations raised by the Customer. {legal.company.name}
        then has a reasonable period to remedy them.
      </p>
      <p>
        In the absence of formal objection by the Customer within 8 days of completion of the works, acceptance
        is deemed tacit.
      </p>

      <h2>Article 10 - Guarantees</h2>

      <h3>10.1 Perfect completion guarantee (1 year)</h3>
      <p>
        In accordance with Article 1792-6 of the French Civil Code, {legal.company.name} guarantees, for{" "}
        <strong>one (1) year</strong> from acceptance of the works, repair of all defects reported by the Customer.
      </p>

      <h3>10.2 Good operation / two-year guarantee (2 years)</h3>
      <p>
        In accordance with Article 1792-3 of the French Civil Code, {legal.company.name} guarantees for{" "}
        <strong>two (2) years</strong> the proper operation of separable equipment elements (pumps, burners,
        thermostats, etc.).
      </p>

      <h3>10.3 Ten-year guarantee (10 years)</h3>
      <p>
        In accordance with Articles 1792 and 2270 of the French Civil Code, {legal.company.name} holds{" "}
        <strong>ten-year liability insurance</strong> covering for <strong>ten (10) years</strong> all damage
        compromising the solidity of the structure or rendering it unfit for its intended purpose.
      </p>
      <p>
        Insurer: {legal.company.insurance.company} - Coverage: {legal.company.insurance.coverage}.
      </p>

      <h3>10.4 Manufacturer's guarantee</h3>
      <p>
        Installed equipment benefits from the manufacturer's guarantee, the duration and terms of which are
        specified in the notice supplied with the equipment. This guarantee is generally 2 to 5 years, extendable
        according to the manufacturer's conditions (Panasonic®, Daikin®, Mitsubishi®, Atlantic®, etc.).
      </p>

      <h2>Article 11 - After-sales service</h2>
      <p>
        {legal.company.name} offers annual maintenance contracts in accordance with French Decree No. 2020-912 of
        28 July 2020 on maintenance of thermodynamic systems. Annual maintenance is <strong>mandatory</strong> for
        heat pumps with an output between 4 and 70 kW, and every 2 years for other equipment.
      </p>
      <p>For any breakdown or malfunction, you may contact us:</p>
      <ul>
        <li>By phone: <a href={`tel:${legal.company.phoneRaw}`}>{legal.company.phone}</a></li>
        <li>By email: <a href={`mailto:${legal.company.email}`}>{legal.company.email}</a></li>
      </ul>

      <h2>Article 12 - Financial grants (MaPrimeRénov', CEE)</h2>
      <p>
        For eligible services, {legal.company.name} may assist the Customer in preparing grant applications
        (MaPrimeRénov', Energy Savings Certificates, zero-interest eco-loan). The Customer nevertheless remains{" "}
        <strong>solely responsible for the accuracy of the information provided</strong> to the bodies (tax
        income, household composition, etc.) and for the validity of their application.
      </p>
      <p>
        {legal.company.name} cannot guarantee grant approval: allocation is solely at the discretion of the
        competent bodies (ANAH, CEE obligated partners) according to their criteria in force on the date of
        submission.
      </p>

      <h2>Article 13 - Force majeure</h2>
      <p>
        Neither party may be held liable for failure to perform its contractual obligations in the event of
        force majeure within the meaning of Article 1218 of the French Civil Code (natural disasters, industrial
        disputes, wars, epidemics, shortages, etc.).
      </p>

      <h2>Article 14 - Complaints & consumer mediation</h2>
      <p>Any complaint must be sent in writing to {legal.company.name}:</p>
      <ul>
        <li>By email: <a href={`mailto:${legal.company.email}`}>{legal.company.email}</a></li>
        <li>By registered post with acknowledgement of receipt to: {legal.company.address}</li>
      </ul>
      <p>
        In the event of a persistent dispute after an attempt at amicable settlement, consumer Customers may
        use consumer mediation free of charge:
      </p>
      <ul>
        <li><strong>{legal.mediator.name}</strong></li>
        <li>{legal.mediator.address}</li>
        <li><a href={legal.mediator.website} target="_blank" rel="noopener noreferrer">{legal.mediator.website}</a></li>
        <li><a href={`mailto:${legal.mediator.email}`}>{legal.mediator.email}</a></li>
      </ul>
      <p>
        European Online Dispute Resolution platform:
        <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener noreferrer">https://ec.europa.eu/consumers/odr</a>
      </p>

      <h2>Article 15 - Governing law & competent jurisdiction</h2>
      <p>
        These GTS are subject to French law. In the event of a dispute not resolved amicably or through mediation,
        the competent court shall be that of the registered office of {legal.company.legalName} (Lille Métropole
        Commercial Court), subject to mandatory public policy provisions applicable to consumers.
      </p>

      <h2>Article 16 - Personal data</h2>
      <p>
        Data collected under this contract is processed in accordance with the GDPR. For more information, please
        see our <a href={privacyPath}>Privacy policy</a>.
      </p>
    </>
  ) : (
    <>
      <p>
        Les présentes Conditions Générales de Vente (ci-après "CGV") régissent les relations contractuelles
        entre la société <strong>{legal.company.legalName}</strong> ({legal.company.name}), {legal.company.legalForm}
        au capital de {legal.company.capital}, immatriculée au RCS de {legal.company.rcs}, dont le siège
        social est sis {legal.company.address} (ci-après "le Prestataire" ou "{legal.company.name}"), et
        toute personne, physique ou morale, faisant appel à ses services (ci-après "le Client").
      </p>

      <h2>Article 1 - Objet</h2>
      <p>Les présentes CGV ont pour objet de définir les conditions dans lesquelles {legal.company.name} fournit ses prestations de :</p>
      <ul>
        <li>Étude, conception, installation, mise en service, entretien et dépannage de pompes à chaleur
          (air-eau, air-air, géothermie, chauffe-eau thermodynamique)</li>
        <li>Étude, installation, mise en service, entretien et dépannage de systèmes de climatisation
          réversible (mono-split, multi-split, gainable, cassette)</li>
        <li>Installation, remplacement et entretien de chaudières (gaz, fioul, hybride, à condensation)</li>
        <li>Travaux de plomberie et de sanitaire</li>
        <li>Montage de dossiers d'aides à la rénovation énergétique (MaPrimeRénov', CEE)</li>
      </ul>
      <p>Toute commande implique l'acceptation sans réserve par le Client des présentes CGV.</p>

      <h2>Article 2 - Devis</h2>
      <p>
        Tout devis est établi <strong>gratuitement, par écrit</strong> (papier ou e-mail), à la suite d'une
        visite technique du logement ou des locaux du Client. Le devis détaille :
      </p>
      <ul>
        <li>La nature précise des prestations et le matériel proposé (marque, modèle, puissance)</li>
        <li>Le prix HT et TTC, en distinguant fourniture et pose</li>
        <li>Le taux de TVA applicable (5,5 %, 10 % ou 20 % selon le cas)</li>
        <li>Une estimation des aides financières mobilisables (MaPrimeRénov', CEE)</li>
        <li>Les modalités et délais d'intervention</li>
        <li>La durée de validité du devis</li>
      </ul>
      <p>
        Sauf mention contraire, <strong>le devis est valable 30 jours</strong> à compter de sa date
        d'émission. Au-delà, {legal.company.name} se réserve le droit de réviser ses tarifs.
      </p>

      <h2>Article 3 - Formation du contrat</h2>
      <p>Le contrat est formé à la date de réception par {legal.company.name} du devis :</p>
      <ul>
        <li>Daté et signé par le Client avec la mention manuscrite "<em>Bon pour accord</em>"</li>
        <li>Accompagné du versement de l'acompte prévu (cf. article 6)</li>
      </ul>
      <p>
        Le devis signé constitue le contrat liant les parties. Aucune modification ne pourra y être
        apportée sans accord écrit des deux parties.
      </p>

      <h2>Article 4 - Droit de rétractation</h2>
      <p>
        Conformément aux articles L.221-18 et suivants du Code de la consommation, le Client consommateur
        bénéficie d'un <strong>délai de rétractation de 14 jours</strong> à compter de la signature du
        contrat, lorsque celui-ci est conclu hors établissement (au domicile du Client ou à distance).
      </p>
      <p>
        Pour exercer ce droit, le Client peut utiliser le formulaire de rétractation joint au devis ou
        notifier sa décision sans ambiguïté à l'adresse {legal.company.email}, par courrier à l'adresse
        {legal.company.address}, ou par tout autre moyen écrit.
      </p>

      <h3>Renonciation au droit de rétractation</h3>
      <p>
        Conformément à l'article L.221-25 du Code de la consommation, le Client peut renoncer expressément
        à son droit de rétractation en cas <strong>d'urgence</strong> (panne nécessitant une intervention
        rapide, hivernage, etc.). Cette renonciation doit être manuscrite, datée et signée par le Client.
      </p>

      <h3>Modèle de formulaire de rétractation</h3>
      <p class="bg-neutral-50 p-4 rounded-lg border border-neutral-200 text-sm">
        À l'attention de {legal.company.legalName}, {legal.company.address}, e-mail : {legal.company.email}<br /><br />
        Je vous notifie par la présente ma rétractation du contrat portant sur la prestation suivante :
        [identification de la prestation]<br /><br />
        Commandé le : [date]<br />
        Nom du consommateur : [nom prénom]<br />
        Adresse du consommateur : [adresse]<br /><br />
        Signature du consommateur (uniquement en cas de notification papier) :<br />
        Date :
      </p>

      <h2>Article 5 - Prix</h2>
      <p>
        Les prix sont exprimés en euros, hors taxes (HT) et toutes taxes comprises (TTC). La TVA
        applicable est celle en vigueur au jour de la facturation. Les taux applicables sont :
      </p>
      <ul>
        <li><strong>5,5 %</strong> sur les travaux d'amélioration de la qualité énergétique dans les logements
          de plus de 2 ans (pompe à chaleur, chauffe-eau thermodynamique, etc.)</li>
        <li><strong>10 %</strong> sur les travaux d'entretien, de réparation et de mise aux normes dans les
          logements de plus de 2 ans</li>
        <li><strong>20 %</strong> sur les autres prestations (logements neufs, locaux professionnels, etc.)</li>
      </ul>
      <p>
        Le Client s'engage à communiquer sur l'honneur les informations permettant l'application du taux
        réduit (date d'achèvement du logement, usage d'habitation, etc.). En cas de remise en cause par
        l'administration fiscale, le différentiel de TVA sera dû par le Client.
      </p>
      <p>
        Les prix comprennent la fourniture du matériel, la main-d'œuvre, le déplacement sur le site et
        la mise en service. Ne sont pas compris, sauf mention contraire : les travaux de gros œuvre, les
        raccordements électriques au tableau, l'évacuation des gravats spécifiques, les renforcements de
        structure.
      </p>

      <h2>Article 6 - Modalités de paiement</h2>
      <p>Sauf accord particulier, le paiement s'effectue selon l'échéancier suivant :</p>
      <ul>
        <li><strong>30 %</strong> à la commande, à titre d'acompte</li>
        <li><strong>40 %</strong> au démarrage des travaux</li>
        <li><strong>30 %</strong> à la réception des travaux, sous 8 jours à compter de la facture</li>
      </ul>
      <p>
        Les <strong>moyens de paiement acceptés</strong> sont : virement bancaire, chèque, espèces (dans
        la limite légale de 1 000 € pour les particuliers résidents fiscaux français), carte bancaire.
      </p>
      <p>
        En cas de retard de paiement, des <strong>pénalités de retard</strong> seront appliquées de plein
        droit au taux légal majoré de 3 points (et au minimum 3 fois le taux d'intérêt légal pour les
        professionnels), à compter du jour suivant la date d'échéance, sans qu'un rappel soit nécessaire.
        Pour les professionnels, une <strong>indemnité forfaitaire de recouvrement de 40 €</strong> sera
        également due (article D.441-5 du Code de commerce).
      </p>

      <h2>Article 7 - Délais d'intervention</h2>
      <p>
        Les délais d'intervention sont communiqués à titre indicatif dans le devis. {legal.company.name}
        s'engage à respecter ces délais dans la mesure du possible. Tout retard ne saurait engager la
        responsabilité du Prestataire en cas de force majeure, d'indisponibilité du Client, de
        modification du projet en cours de chantier ou de retard d'approvisionnement des fournisseurs.
      </p>

      <h2>Article 8 - Obligations du Client</h2>
      <p>Le Client s'engage à :</p>
      <ul>
        <li>Permettre le libre accès aux locaux le jour convenu</li>
        <li>Mettre à disposition l'électricité et l'eau nécessaires à l'exécution des travaux</li>
        <li>Protéger ses biens et meubles dans la zone de chantier</li>
        <li>Communiquer toutes informations utiles à l'intervention (plans, schémas électriques, etc.)</li>
        <li>Régler les sommes dues aux échéances convenues</li>
      </ul>

      <h2>Article 9 - Réception des travaux</h2>
      <p>
        À l'achèvement des travaux, un <strong>procès-verbal de réception</strong> est établi
        contradictoirement entre le Client et {legal.company.name}. Il consigne, le cas échéant, les
        réserves émises par le Client. {legal.company.name} dispose alors d'un délai raisonnable pour
        lever ces réserves.
      </p>
      <p>
        En l'absence d'opposition formelle du Client dans les 8 jours suivant l'achèvement des travaux,
        la réception est réputée tacite.
      </p>

      <h2>Article 10 - Garanties</h2>

      <h3>10.1 Garantie de parfait achèvement (1 an)</h3>
      <p>
        Conformément à l'article 1792-6 du Code civil, {legal.company.name} garantit, pendant
        <strong> un (1) an</strong> à compter de la réception des travaux, la réparation de tous les
        désordres signalés par le Client.
      </p>

      <h3>10.2 Garantie de bon fonctionnement / biennale (2 ans)</h3>
      <p>
        Conformément à l'article 1792-3 du Code civil, {legal.company.name} garantit pendant
        <strong> deux (2) ans</strong> le bon fonctionnement des éléments d'équipement dissociables de
        l'ouvrage (pompes, brûleurs, thermostats, etc.).
      </p>

      <h3>10.3 Garantie décennale (10 ans)</h3>
      <p>
        Conformément aux articles 1792 et 2270 du Code civil, {legal.company.name} est titulaire d'une
        <strong>assurance décennale</strong> couvrant pendant <strong>dix (10) ans</strong> tous les
        dommages compromettant la solidité de l'ouvrage ou le rendant impropre à sa destination.
      </p>
      <p>
        Compagnie : {legal.company.insurance.company} - Couverture : {legal.company.insurance.coverage}.
      </p>

      <h3>10.4 Garantie constructeur</h3>
      <p>
        Le matériel installé bénéficie de la garantie constructeur du fabricant, dont la durée et les
        modalités sont précisées dans la notice fournie avec l'équipement. Cette garantie est généralement
        de 2 à 5 ans, extensible selon les conditions du constructeur (Panasonic®, Daikin®, Mitsubishi®,
        Atlantic®, etc.).
      </p>

      <h2>Article 11 - Service après-vente</h2>
      <p>
        {legal.company.name} propose des contrats d'entretien annuels conformément au décret
        n° 2020-912 du 28 juillet 2020 relatif à l'entretien des systèmes thermodynamiques. L'entretien
        annuel est <strong>obligatoire</strong> pour les pompes à chaleur dont la puissance est comprise
        entre 4 et 70 kW, et tous les 2 ans pour les autres équipements.
      </p>
      <p>Pour toute panne ou dysfonctionnement, vous pouvez nous contacter :</p>
      <ul>
        <li>Par téléphone : <a href={`tel:${legal.company.phoneRaw}`}>{legal.company.phone}</a></li>
        <li>Par e-mail : <a href={`mailto:${legal.company.email}`}>{legal.company.email}</a></li>
      </ul>

      <h2>Article 12 - Aides financières (MaPrimeRénov', CEE)</h2>
      <p>
        Dans le cadre de prestations éligibles, {legal.company.name} peut accompagner le Client dans le
        montage de ses dossiers d'aides (MaPrimeRénov', Certificats d'Économie d'Énergie, éco-PTZ). Le
        Client reste toutefois <strong>seul responsable de la véracité des informations qu'il fournit</strong>
        aux organismes (revenu fiscal, composition du foyer, etc.) et de la validité de sa demande.
      </p>
      <p>
        {legal.company.name} ne peut garantir l'obtention des aides : leur attribution relève exclusivement
        des organismes compétents (ANAH, partenaires obligés CEE) selon leurs propres critères en vigueur
        au jour du dépôt du dossier.
      </p>

      <h2>Article 13 - Force majeure</h2>
      <p>
