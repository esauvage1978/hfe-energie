---
import type { Locale } from "@i18n";
import { getBlogIndexContent, pathFor } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import StructuredData from "@components/StructuredData.astro";
import { logos } from "@data/assets";
import { getBlogMedia } from "@data/blog-media";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getBlogIndexContent(locale);
const canonicalPath = pathFor("blog", locale);
const { hero } = content;
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  keywords={[...content.seo.keywords]}
  canonicalPath={canonicalPath}
  image={hero.image.src}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={[...content.breadcrumbs]} slot="head" />

  <div class="container-page">
    <Breadcrumbs locale={locale} items={[...content.breadcrumbs]} />
  </div>

  <section class="blog-hero" aria-labelledby="blog-hero-title">
    <div class="container-page">
      <div class="blog-hero__panel">
        <div class="blog-hero__grid">
          <div class="blog-hero__copy">
            <div class="blog-hero__brand">
              <Picture
                src={logos.icon.src}
                alt=""
                width={48}
                height={38}
                class="blog-hero__logo"
                loading="eager"
                fetchpriority="high"
              />
              <div>
                <p class="blog-hero__brand-name" aria-hidden="true">
                  <span class="text-primary-700">H</span><span class="text-primary-600">F</span><span class="text-accent-500">E</span>
                </p>
                <p class="blog-hero__brand-legal">{hero.brandName}</p>
                <p class="blog-hero__brand-tagline">{hero.brandTagline}</p>
              </div>
            </div>

            <h1 id="blog-hero-title" class="blog-hero__title">
              <span class="blog-hero__title-eyebrow">{hero.titleEyebrow}</span>
              <span class="blog-hero__title-main">{hero.title}</span>
            </h1>

            <p class="blog-hero__desc">
              {hero.descriptionBefore}
              {" "}
              <strong>{hero.highlights[0]}</strong>,{" "}
              <strong>{hero.highlights[1]}</strong>
              {locale === "en" ? " and " : " et "}
              <strong>{hero.highlights[2]}</strong>.
            </p>

            <ul class="blog-hero__pillars">
              {hero.pillars.map((pillar) => (
                <li class:list={["blog-hero__pillar", `is-${pillar.tone}`]}>
                  <span class="blog-hero__pillar-icon" aria-hidden="true">
                    <Icon name={pillar.icon} size={18} />
                  </span>
                  <span class="blog-hero__pillar-text">
                    <strong>{pillar.labelStrong}</strong> {pillar.labelRest}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <div class="blog-hero__media">
            <Picture
              src={hero.image.src}
              alt={hero.image.alt}
              width={hero.image.width}
              height={hero.image.height}
              class="blog-hero__photo"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              sizes="(min-width: 1024px) 42vw, 100vw"
            />
          </div>
        </div>

        <div class="blog-hero__bar">
          <ul class="blog-hero__services">
            {hero.services.map((service) => (
              <li>
                <Icon name={service.icon} size={16} class="text-accent-300" />
                <span>{service.label}</span>
              </li>
            ))}
          </ul>
          <p class="blog-hero__slogan">
            {hero.sloganBefore}<em>{hero.sloganHighlight}</em>{hero.sloganAfter}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="blog-posts-title">
    <div class="container-page max-w-3xl">
      <h2 id="blog-posts-title" class="sr-only">
        {locale === "en" ? "Articles" : "Articles"}
      </h2>
      <ul class="space-y-5">
        {content.posts.map((post) => {
          const media = "mediaId" in post ? getBlogMedia(post.mediaId) : null;
          return (
          <li>
            <a
              href={pathFor(post.routeId, locale)}
              class="block rounded-2xl border border-neutral-200 bg-white p-6 md:p-7 hover:border-accent-300 hover:shadow-md transition-all"
            >
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-500">
                  <span class="badge bg-accent-50 text-accent-800">{post.tag}</span>
                  <time datetime={post.date}>{post.dateLabel}</time>
                </div>
                {media && (
                  <img
                    src={media.logoSrc}
                    alt={media.logoAlt}
                    width={media.width}
                    height={media.height}
                    class:list={["blog-post-media", `blog-post-media--${media.id}`]}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <h3 class="mt-3 font-display font-extrabold text-xl md:text-2xl text-neutral-900 leading-snug">
                {post.title}
              </h3>
              <p class="mt-2 text-neutral-600 leading-relaxed">{post.excerpt}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent-700">
                {locale === "en" ? "Read the article" : "Lire l'article"}
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          </li>
          );
        })}
      </ul>
    </div>
  </section>

  <CtaBanner locale={locale} title={content.cta.title} subtitle={content.cta.subtitle} />
</BaseLayout>

<style>
  .blog-hero {
    padding-bottom: 0.5rem;
    background:
      radial-gradient(ellipse 55% 70% at 8% 30%, rgb(0 176 64 / 0.07), transparent 60%),
      linear-gradient(180deg, #ffffff 0%, #f7fbf9 100%);
  }

  .blog-hero__panel {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(0 128 192 / 0.12);
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: 0 12px 36px rgb(0 73 122 / 0.08);
  }

  .blog-hero__grid {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem 1.25rem 1.25rem;
  }

  @media (min-width: 768px) {
    .blog-hero__grid {
      padding: 1.75rem 1.75rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .blog-hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
      gap: 1.5rem;
      align-items: center;
      min-height: 22rem;
      padding: 1.75rem 1.75rem 1.25rem;
    }
  }

  .blog-hero__copy {
    position: relative;
    z-index: 1;
  }

  .blog-hero__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .blog-hero__logo {
    width: 2.75rem;
    height: auto;
    flex-shrink: 0;
  }

  .blog-hero__brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .blog-hero__brand-legal {
    margin-top: 0.1rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-primary-900);
    line-height: 1.2;
  }

  .blog-hero__brand-tagline {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-accent-600);
    line-height: 1.2;
  }

  .blog-hero__title {
    margin: 0;
    line-height: 0.92;
  }

  .blog-hero__title-eyebrow {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-500);
  }

  .blog-hero__title-main {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    letter-spacing: -0.03em;
    color: var(--color-primary-900);
  }

  .blog-hero__desc {
    margin: 0.85rem 0 0;
    max-width: 32rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--color-neutral-700);
  }

  .blog-hero__desc strong {
    color: var(--color-neutral-900);
    font-weight: 800;
  }

  .blog-hero__pillars {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  @media (min-width: 640px) {
    .blog-hero__pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.65rem;
    }
  }

  .blog-hero__pillar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .blog-hero__pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 9999px;
    flex-shrink: 0;
    color: #fff;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
  }

  .blog-hero__pillar.is-primary .blog-hero__pillar-icon {
    background: linear-gradient(145deg, var(--color-primary-500), var(--color-primary-700));
  }

  .blog-hero__pillar.is-accent .blog-hero__pillar-icon {
    background: linear-gradient(145deg, var(--color-accent-400), var(--color-accent-600));
  }

  .blog-hero__pillar-text {
    font-size: 0.78rem;
    line-height: 1.25;
    color: var(--color-neutral-700);
  }

  .blog-hero__pillar.is-primary .blog-hero__pillar-text strong {
    color: var(--color-primary-800);
  }

  .blog-hero__pillar.is-accent .blog-hero__pillar-text strong {
    color: var(--color-accent-700);
  }

  .blog-hero__media {
    position: relative;
    border-radius: 1.15rem;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: 0 10px 28px rgb(0 73 122 / 0.14);
  }

  @media (min-width: 1024px) {
    .blog-hero__media {
      aspect-ratio: 5 / 4;
      max-height: 20rem;
      justify-self: stretch;
    }

    .blog-hero__media::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 28%;
      z-index: 1;
      background: linear-gradient(90deg, #fff 0%, rgb(255 255 255 / 0) 100%);
      pointer-events: none;
    }
  }

  .blog-hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-hero__bar {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.85rem 1.25rem;
    background: linear-gradient(95deg, var(--color-primary-950), var(--color-primary-800) 55%, var(--color-primary-700));
    color: #fff;
  }

  @media (min-width: 768px) {
    .blog-hero__bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.9rem 1.75rem;
    }
  }

  .blog-hero__services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .blog-hero__services li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .blog-hero__slogan {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    font-style: italic;
    color: rgb(255 255 255 / 0.95);
  }

  .blog-hero__slogan em {
    color: var(--color-accent-300);
    font-style: italic;
    font-weight: 800;
  }

  .blog-post-media {
    display: block;
    width: auto;
    height: 1.5rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .blog-post-media--tf1 {
    height: 1.35rem;
  }

  .blog-post-media--bfmtv {
    height: 1.85rem;
  }
</style>
