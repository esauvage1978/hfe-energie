---
import type { Locale } from "@i18n";
import { getProjectColorScheme, getPageThemeClasses, pathFor } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import StructuredData from "@components/StructuredData.astro";
import { site } from "@data/site";
import { getProjectsIndexContent } from "@i18n/content/projects-index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getProjectsIndexContent(locale);
const canonicalPath = pathFor("projects", locale);
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  keywords={[...content.seo.keywords]}
  canonicalPath={canonicalPath}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={[...content.breadcrumbs]} slot="head" />

  <div class="container-page">
    <Breadcrumbs locale={locale} items={[...content.breadcrumbs]} />
  </div>

  <section class="bg-gradient-to-br from-accent-50 via-white to-accent-50/20">
    <div class="container-page py-10 md:py-16 max-w-4xl">
      <span class="badge bg-accent-100 text-accent-800">{content.hero.badge}</span>
      <h1 class="mt-3 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
        {content.hero.title}
      </h1>
      <p class="mt-4 text-lg text-neutral-700">{content.hero.description}</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a href={pathFor("contact", locale)} class="btn btn-accent"><Icon name="mail" size={18} /> {content.hero.ctaQuote}</a>
        <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent"><Icon name="phone" size={18} /> {site.phone}</a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
        {content.items.map((item) => {
          const colorScheme = getProjectColorScheme(item.route);
          const theme = getPageThemeClasses(colorScheme);
          return (
            <a
              href={pathFor(item.route, locale)}
              class:list={[
                "group rounded-2xl bg-white border overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200",
                theme.indexCardBorder,
                theme.indexCardTopAccent,
                theme.indexCardHover,
              ]}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-neutral-100">
                <Picture
                  src={item.cover.src}
                  alt={item.cover.alt}
                  width={item.cover.width}
                  height={item.cover.height}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                />
                <span class:list={["absolute top-3 left-3 badge shadow-md backdrop-blur-sm", theme.indexCoverBadge]}>
                  <Icon name="star" size={13} class={theme.indexCoverBadgeIcon} />
                  {content.countLabel(item.count)}
                </span>
              </div>
              <div class="p-5 md:p-6">
                <h2 class:list={[
                  "font-display font-extrabold text-xl md:text-2xl text-neutral-900 transition-colors",
                  theme.indexTitleHover,
                ]}>
                  {item.title}
                </h2>
                <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{item.description}</p>
                <span class:list={[
                  "mt-4 inline-flex items-center gap-1 text-sm font-semibold group-hover:gap-2 transition-all",
                  theme.indexLink,
                ]}>
                  {content.seeProjects} <Icon name="arrow-right" size={16} />
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBanner locale={locale} title={content.cta.title} subtitle={content.cta.subtitle} />
</BaseLayout>
