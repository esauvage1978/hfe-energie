---
import type { Locale } from "@i18n";
import { getRecruitmentContent, pathFor } from "@i18n";
import {
  getActiveJobPostings,
  getJobDescriptionHtml,
  getRecruitmentJobs,
} from "@i18n/content/recruitment-jobs";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import StructuredData from "@components/StructuredData.astro";
import { buildJobPostingsGraph } from "@/lib/job-posting-schema";
import { site } from "@data/site";
import { heroes } from "@data/assets";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getRecruitmentContent(locale);
const jobs = getRecruitmentJobs(locale);
const canonicalPath = pathFor("recruitment", locale);
const pageUrl = new URL(canonicalPath, site.baseUrl).toString();
const applyFormUrl = `${pathFor("contact", locale)}?service=recrutement#contact-form`;
// JobPosting uniquement pour les offres non expirées (validThrough >= date du build)
const activeJobs = getActiveJobPostings(locale);
const jobPostingsLd = buildJobPostingsGraph(
  activeJobs.map((job) => ({
    id: job.id,
    title: job.title,
    descriptionHtml: getJobDescriptionHtml(job, locale),
    datePosted: job.datePosted,
    validThrough: job.validThrough,
    employmentType: job.employmentType,
    jobStartDate: job.jobStartDate,
    experienceMonths: job.experienceMonths,
  })),
  pageUrl,
);
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  keywords={[...content.seo.keywords]}
  canonicalPath={canonicalPath}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={content.breadcrumbs} slot="head" />
  {activeJobs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(jobPostingsLd)} slot="head" is:inline />
  )}

  <div class="container-page">
    <Breadcrumbs locale={locale} items={content.breadcrumbs} />
  </div>

  <section class="bg-gradient-to-br from-accent-50 to-white">
    <div class="container-page py-10 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="badge bg-accent-100 text-accent-800">
            <Icon name="award" size={12} />
            {content.hero.badge}
          </span>
          <h1 class="mt-4 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
            {content.hero.title}
          </h1>
          <p class="mt-4 text-lg text-neutral-700 leading-relaxed">{content.hero.description}</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={applyFormUrl} class="btn btn-accent">
              <Icon name="mail" size={18} />
              {content.hero.ctaApply}
            </a>
            <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent">
              <Icon name="phone" size={18} />
              {site.phone}
            </a>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <Picture
            src={heroes.team.src}
            alt={heroes.team.alt}
            width={heroes.team.width}
            height={heroes.team.height}
            class="rounded-3xl shadow-xl border border-neutral-100 w-full max-w-md lg:max-w-none aspect-[4/5] object-cover object-[center_25%]"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white border-b border-neutral-100" aria-labelledby="jobs-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 id="jobs-title" class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          {content.jobs.title}
        </h2>
        <p class="mt-3 text-neutral-700 leading-relaxed">{content.jobs.intro}</p>
      </div>

      <div class="mt-10 space-y-8">
        {jobs.map((job) => (
          <article
            id={job.slug}
            class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 md:p-8 shadow-sm"
          >
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
              <div class="max-w-3xl">
                <h3 class="font-display font-extrabold text-xl md:text-2xl text-neutral-900">{job.title}</h3>
                <p class="mt-2 text-neutral-700 leading-relaxed">{job.summary}</p>
              </div>
              <a href={`${applyFormUrl}&job=${encodeURIComponent(job.title)}`} class="btn btn-accent shrink-0 self-start">
                <Icon name="mail" size={18} />
                {content.jobs.applyCta}
              </a>
            </div>

            <dl class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
              <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3">
                <dt class="font-semibold text-neutral-900">{content.jobs.contractLabel}</dt>
                <dd class="mt-1 text-neutral-600">{job.contract}</dd>
              </div>
              <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3">
                <dt class="font-semibold text-neutral-900">{content.jobs.locationLabel}</dt>
                <dd class="mt-1 text-neutral-600">{job.location}</dd>
              </div>
              <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3">
                <dt class="font-semibold text-neutral-900">{content.jobs.startLabel}</dt>
                <dd class="mt-1 text-neutral-600">{job.startDate}</dd>
              </div>
            </dl>

            <p class="mt-6 text-neutral-700 leading-relaxed">{job.intro}</p>

            <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div>
                <h4 class="font-display font-bold text-base text-neutral-900">{content.jobs.missionsLabel}</h4>
                <ul class="mt-3 space-y-2 text-sm text-neutral-600">
                  {job.responsibilities.map((item) => (
                    <li class="flex items-start gap-2">
                      <Icon name="check" size={16} class="text-accent-600 mt-0.5 shrink-0" strokeWidth={3} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="font-display font-bold text-base text-neutral-900">{content.jobs.requirementsLabel}</h4>
                <ul class="mt-3 space-y-2 text-sm text-neutral-600">
                  {job.requirements.map((item) => (
                    <li class="flex items-start gap-2">
                      <Icon name="check" size={16} class="text-accent-600 mt-0.5 shrink-0" strokeWidth={3} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-6">
              <h4 class="font-display font-bold text-base text-neutral-900">{content.jobs.benefitsLabel}</h4>
              <ul class="mt-3 space-y-2 text-sm text-neutral-600">
                {job.profile.map((item) => (
                  <li class="flex items-start gap-2">
                    <Icon name="check" size={16} class="text-accent-600 mt-0.5 shrink-0" strokeWidth={3} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="profiles-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 id="profiles-title" class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          {content.profiles.title}
        </h2>
        <p class="mt-3 text-neutral-700 leading-relaxed">{content.profiles.intro}</p>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5">
        {content.profiles.items.map((item) => (
          <article class="card flex flex-col h-full">
            <div class="w-12 h-12 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center mb-4">
              <Icon name={item.icon} size={24} />
            </div>
            <h3 class="font-display font-bold text-lg text-neutral-900">{item.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{item.desc}</p>
            <ul class="mt-4 space-y-2 text-sm text-neutral-600 flex-1">
              {item.details.map((detail) => (
                <li class="flex items-start gap-2">
                  <Icon name="check" size={16} class="text-accent-600 mt-0.5 shrink-0" strokeWidth={3} />
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50 border-y border-neutral-100" aria-labelledby="why-title">
    <div class="container-page">
      <h2 id="why-title" class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900 max-w-3xl">
        {content.why.title}
      </h2>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {content.why.items.map((item) => (
          <article class="card bg-white">
            <h3 class="font-display font-bold text-base text-neutral-900">{item.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="apply-title">
    <div class="container-page">
      <div class="max-w-3xl mx-auto text-center">
        <h2 id="apply-title" class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          {content.apply.title}
        </h2>
        <p class="mt-4 text-neutral-700 leading-relaxed">{content.apply.intro}</p>
      </div>

      <div class="mt-8 max-w-2xl mx-auto">
        <ol class="space-y-3">
          {content.apply.steps.map((step, i) => (
            <li class="flex items-start gap-4 rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-600 text-sm font-bold text-white">
                {i + 1}
              </span>
              <span class="pt-1 text-sm text-neutral-700 leading-relaxed">{step}</span>
            </li>
          ))}
        </ol>

        <div class="mt-8 rounded-2xl border border-accent-200 bg-accent-50 p-6 text-center">
          <a href={applyFormUrl} class="btn btn-accent">
            <Icon name="mail" size={18} />
            {content.apply.formCta}
          </a>
          <p class="mt-3 text-xs text-neutral-600">{content.apply.formHint}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="recruitment-cta-title">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-accent-700 via-accent-800 to-accent-900 p-8 md:p-12 text-white shadow-xl">
        <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div class="max-w-2xl">
            <h2 id="recruitment-cta-title" class="text-2xl md:text-4xl font-display font-extrabold text-white">
              {content.cta.title}
            </h2>
            <p class="mt-3 text-base md:text-lg text-accent-100">{content.cta.subtitle}</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href={applyFormUrl} class="btn bg-white text-accent-800 hover:bg-accent-50">
              <Icon name="mail" size={18} />
              {content.hero.ctaApply}
            </a>
            <a href={`tel:${site.phoneRaw}`} class="btn bg-transparent text-white border-2 border-white/40 hover:bg-white/10">
              <Icon name="phone" size={18} />
              {site.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
