---
import type { Locale } from "@i18n";
import { getCoOwnershipContent, pathFor } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import StructuredData from "@components/StructuredData.astro";
import Faq from "@components/Faq.astro";
import PanasonicPartnerPromo from "@components/PanasonicPartnerPromo.astro";
import { site } from "@data/site";
import { servicesImages } from "@data/assets";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getCoOwnershipContent(locale);
const canonicalPath = pathFor("coOwnership", locale);
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  keywords={[...content.seo.keywords]}
  canonicalPath={canonicalPath}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={content.breadcrumbs} slot="head" />
  <StructuredData type="FAQPage" faqs={content.faq.items} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={content.breadcrumbs} />
  </div>

  <section class="bg-gradient-to-br from-accent-50 to-white">
    <div class="container-page py-10 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="badge bg-accent-100 text-accent-800">{content.hero.badge}</span>
          <h1 class="mt-3 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
            {content.hero.titleBefore}<span class="text-accent-700">{content.hero.titleHighlight}</span>
          </h1>
          <p class="mt-4 text-lg text-neutral-700">{content.hero.description}</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={pathFor("contact", locale)} class="btn btn-accent"><Icon name="mail" size={18} /> {content.hero.ctaQuote}</a>
            <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent"><Icon name="phone" size={18} /> {site.phone}</a>
          </div>
        </div>
        <div>
          <Picture
            src={servicesImages.chauffage.src}
            alt={servicesImages.chauffage.alt}
            width={servicesImages.chauffage.width}
            height={servicesImages.chauffage.height}
            class="rounded-3xl shadow-xl border border-neutral-100 w-full aspect-[4/3] object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="intro-title">
    <div class="container-page max-w-3xl">
      <h2 id="intro-title" class="font-display text-2xl md:text-3xl font-extrabold text-neutral-900">
        {content.intro.title}
      </h2>
      <div class="mt-5 space-y-4 text-neutral-700 leading-relaxed">
        {content.intro.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50">
    <div class="container-page">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900 max-w-3xl">
        {content.services.title}
      </h2>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {content.services.items.map((o) => (
          <div class="card">
            <div class="w-12 h-12 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center mb-4">
              <Icon name={o.icon} size={24} />
            </div>
            <h3 class="font-display font-bold text-lg text-neutral-900">{o.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{o.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="grants-copro-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <span class="badge bg-accent-100 text-accent-800">{content.grants.badge}</span>
        <h2 id="grants-copro-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          {content.grants.title}
        </h2>
        <p class="mt-3 text-neutral-700">{content.grants.intro}</p>
      </div>
      <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
        {content.grants.items.map((a) => (
          <article class="card">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-display font-extrabold text-xl text-neutral-900">{a.name}</h3>
              <span class="badge bg-accent-100 text-accent-800 shrink-0">{a.amount}</span>
            </div>
            <p class="text-sm text-neutral-700 leading-relaxed">{a.desc}</p>
            <ul class="mt-4 space-y-2">
              {a.conditions.map((c) => (
                <li class="flex items-start gap-2 text-sm">
                  <Icon name="check" size={16} class="text-accent-600 mt-0.5 shrink-0" strokeWidth={3} />
                  <span class="text-neutral-700">{c}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="mt-6 max-w-3xl text-sm text-neutral-600 leading-relaxed">{content.grants.note}</p>
    </div>
  </section>

  <section class="section bg-accent-50/50 border-y border-accent-100" aria-labelledby="savings-title">
    <div class="container-page">
      <h2 id="savings-title" class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900 max-w-3xl">
        {content.savings.title}
      </h2>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {content.savings.items.map((item) => (
          <article class="card bg-white">
            <h3 class="font-display font-bold text-base text-neutral-900">{item.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <PanasonicPartnerPromo locale={locale} variant="coOwnership" />

  <section class="section bg-neutral-50" aria-labelledby="faq-copro-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <span class="badge bg-accent-100 text-accent-800">{content.faq.badge}</span>
        <h2 id="faq-copro-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          {content.faq.title}
        </h2>
        <p class="mt-3 text-neutral-700">{content.faq.intro}</p>
      </div>
      <div class="mt-8 max-w-4xl">
        <Faq items={content.faq.items} idPrefix="copro-faq" />
      </div>
    </div>
  </section>

  <CtaBanner locale={locale} title={content.cta.title} subtitle={content.cta.subtitle} />
</BaseLayout>
