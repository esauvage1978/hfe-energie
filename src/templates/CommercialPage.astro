---
import type { Locale } from "@i18n";
import { getCommercialContent, pathFor } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import StructuredData from "@components/StructuredData.astro";
import LogoCloud from "@components/LogoCloud.astro";
import Faq from "@components/Faq.astro";
import PanasonicPartnerPromo from "@components/PanasonicPartnerPromo.astro";
import { site } from "@data/site";
import { servicesImages, clientsReferences } from "@data/assets";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getCommercialContent(locale);
const canonicalPath = pathFor("commercial", locale);
---

<BaseLayout locale={locale} title={content.seo.title} description={content.seo.description} canonicalPath={canonicalPath}>
  <StructuredData type="BreadcrumbList" breadcrumbs={content.breadcrumbs} slot="head" />
  <StructuredData type="FAQPage" faqs={content.faq.items} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={content.breadcrumbs} />
  </div>

  <section class="bg-gradient-to-br from-accent-50 to-white">
    <div class="container-page py-10 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="badge bg-accent-100 text-accent-800">{content.hero.badge}</span>
          <h1 class="mt-3 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
            {content.hero.titleBefore}<span class="text-accent-700">{content.hero.titleHighlight}</span>
          </h1>
          <p class="mt-4 text-lg text-neutral-700">{content.hero.description}</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={pathFor("contact", locale)} class="btn btn-accent"><Icon name="mail" size={18} /> {content.hero.ctaAudit}</a>
            <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent"><Icon name="phone" size={18} /> {site.phone}</a>
          </div>
        </div>
        <div>
          <Picture
            src={servicesImages.professionnels.src}
            alt={servicesImages.professionnels.alt}
            width={servicesImages.professionnels.width}
            height={servicesImages.professionnels.height}
            class="rounded-3xl shadow-xl border border-neutral-100 w-full aspect-[4/3] object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900 max-w-3xl">
        {content.offers.title}
      </h2>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {content.offers.items.map((o) => {
          const hasProjects = "projectsRoute" in o && "projectsLabel" in o;
          return (
          <div class:list={["card", hasProjects && "card-linkable"]}>
            {hasProjects && (
              <a
                href={pathFor(o.projectsRoute as any, locale)}
                class="card-stretched-link"
                aria-label={o.projectsLabel}
              />
            )}
            <div class="w-12 h-12 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center mb-4">
              <Icon name="shield" size={24} />
            </div>
            <h3 class="font-display font-bold text-lg text-neutral-900">{o.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{o.desc}</p>
            {hasProjects && (
              <span class="link-projects mt-5 pointer-events-none" aria-hidden="true">
                <Icon name="star" size={14} />
                {o.projectsLabel}
                <Icon name="arrow-right" size={14} />
              </span>
            )}
          </div>
          );
        })}
      </div>
    </div>
  </section>

  <LogoCloud
    title={content.clients.title}
    subtitle={content.clients.subtitle}
    items={clientsReferences}
    variant="clients"
  />

  <div class="container-page pb-6 -mt-4">
    <a href={pathFor("projectsClimPro", locale)} class="link-projects">
      <Icon name="star" size={14} />
      {locale === "fr" ? "Voir nos chantiers de climatisation professionnelle en détail" : "See our commercial air conditioning projects in detail"}
      <Icon name="arrow-right" size={14} />
    </a>
  </div>

  <PanasonicPartnerPromo locale={locale} variant="commercial" />

  <section class="section bg-white" aria-labelledby="faq-b2b-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <span class="badge bg-accent-100 text-accent-800">{content.faq.badge}</span>
        <h2 id="faq-b2b-title" class="mt-3 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          {content.faq.title}
        </h2>
        <p class="mt-3 text-neutral-700">{content.faq.intro}</p>
      </div>

      <div class="mt-8 max-w-4xl">
        <Faq items={content.faq.items} idPrefix="b2b-faq" />
      </div>
    </div>
  </section>

  <CtaBanner locale={locale} title={content.cta.title} subtitle={content.cta.subtitle} />
</BaseLayout>
