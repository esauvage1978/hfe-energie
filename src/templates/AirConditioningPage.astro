---
import type { Locale } from "@i18n";
import { getAirConditioningContent, pathFor } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import LastUpdated from "@components/LastUpdated.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import StructuredData from "@components/StructuredData.astro";
import Faq from "@components/Faq.astro";
import PartnersCertificationsSections from "@components/PartnersCertificationsSections.astro";
import Picture from "@components/Picture.astro";
import { site } from "@data/site";
import { partenaires, servicesImages } from "@data/assets";

const panasonicLogo = partenaires.find((p) => p.name === "Panasonic")!;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getAirConditioningContent(locale);
const canonicalPath = pathFor("airConditioning", locale);
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  keywords={[...content.seo.keywords]}
  canonicalPath={canonicalPath}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={content.breadcrumbs} slot="head" />
  <StructuredData
    type="Service"
    service={{
      name: content.structuredData.serviceName,
      description: content.structuredData.serviceDescription,
      path: canonicalPath,
    }}
    slot="head"
  />
  <StructuredData type="FAQPage" faqs={content.faq.items} slot="head" />

  <div class="container-page">
    <Breadcrumbs locale={locale} items={content.breadcrumbs} />
    <LastUpdated locale={locale} file="src/i18n/content/air-conditioning.ts" />
  </div>

  <section class="bg-gradient-to-br from-accent-50 via-white to-accent-100/40">
    <div class="container-page py-10 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="badge bg-accent-100 text-accent-800">
            <Icon name="snowflake" size={12} />
            {content.hero.badge}
          </span>
          <h1 class="mt-4 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
            {content.hero.titleBefore}<span class="text-accent-700">{content.hero.titleHighlight}</span>
          </h1>
          <p class="mt-4 text-lg text-neutral-700 leading-relaxed">{content.hero.description}</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={pathFor("contact", locale)} class="btn btn-accent"><Icon name="mail" size={18} /> {content.hero.ctaQuote}</a>
            <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent"><Icon name="phone" size={18} /> {site.phone}</a>
          </div>
        </div>
        <div>
          <Picture
            src={servicesImages.climatisation.src}
            alt={servicesImages.climatisation.alt}
            width={servicesImages.climatisation.width}
            height={servicesImages.climatisation.height}
            class="rounded-3xl shadow-xl border border-neutral-100 w-full aspect-[4/3] object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="types-clim-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 id="types-clim-title" class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          {content.types.title}
        </h2>
        <p class="mt-3 text-neutral-700">{content.types.intro}</p>
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {content.types.items.map((t) => {
          const hasDetail = "detailRoute" in t && "detailLabel" in t;
          return (
          <article class:list={["card flex flex-col h-full", hasDetail && "card-linkable"]}>
            {hasDetail && (
              <a
                href={`${pathFor(t.detailRoute, locale)}${"detailHash" in t && t.detailHash ? t.detailHash : ""}`}
                class="card-stretched-link"
                aria-label={t.detailLabel}
              />
            )}
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center shrink-0">
                <Icon name="snowflake" size={22} />
              </div>
              <h3 class="font-display font-extrabold text-xl text-neutral-900">{t.name}</h3>
            </div>
            <p class="mt-3 text-sm text-neutral-700 leading-relaxed">{t.description}</p>

            <div class="mt-4 rounded-xl bg-accent-50/70 border border-accent-100 px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-accent-800">{content.types.idealForLabel}</p>
              <p class="mt-1 text-sm text-neutral-700 leading-relaxed">{t.use}</p>
            </div>

            <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-accent-800">{content.types.advantagesLabel}</p>
            <ul class="mt-3 space-y-2 flex-1">
              {t.advantages.map((a) => (
                <li class="flex items-start gap-2 text-sm">
                  <Icon name="check" size={16} class="text-accent-600 mt-0.5 shrink-0" strokeWidth={3} />
                  <span class="text-neutral-700">{a}</span>
                </li>
              ))}
            </ul>

            {hasDetail && (
              <span class="link-projects mt-5 self-start pointer-events-none" aria-hidden="true">
                <Icon name="arrow-right" size={14} />
                {t.detailLabel}
              </span>
            )}
          </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-gradient-to-br from-neutral-900 via-neutral-900 to-accent-950 text-white" aria-labelledby="comfort-cloud-title">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-2 lg:grid-rows-[auto_auto] gap-10 lg:gap-x-14 lg:gap-y-6 items-start">
        <div class="lg:row-span-2">
          <span class="badge bg-accent-500/20 text-accent-200 border border-accent-400/30">
            <Icon name="phone" size={12} />
            {content.comfortCloud.badge}
          </span>
          <h2 id="comfort-cloud-title" class="mt-4 font-display text-3xl md:text-4xl font-extrabold leading-tight text-white">
            {content.comfortCloud.title}
          </h2>
          <p class="mt-4 text-neutral-300 leading-relaxed">{content.comfortCloud.intro}</p>

          <div class="mt-8 grid grid-cols-3 gap-3">
            {content.comfortCloud.highlights.map((h) => (
              <div class="rounded-xl bg-white/5 border border-white/10 px-3 py-4 text-center">
                <p class="font-display font-extrabold text-2xl text-accent-300">{h.value}</p>
                <p class="mt-1 text-xs text-neutral-400 leading-snug">{h.label}</p>
              </div>
            ))}
          </div>

          <ul class="mt-6 space-y-2">
            {content.comfortCloud.extras.map((extra) => (
              <li class="flex items-start gap-2 text-sm text-neutral-300">
                <Icon name="check" size={16} class="text-accent-400 mt-0.5 shrink-0" strokeWidth={3} />
                <span>{extra}</span>
              </li>
            ))}
          </ul>

          <p class="mt-6 text-sm text-neutral-400 leading-relaxed border-t border-white/10 pt-5">
            {content.comfortCloud.note}
          </p>

          <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3">
            <a href={pathFor("contact", locale)} class="btn btn-accent">
              <Icon name="mail" size={18} />
              {content.comfortCloud.cta}
            </a>
            <a
              href={pathFor("panasonicPartner", locale)}
              class="btn border-2 border-white/30 bg-transparent text-white hover:bg-white/10 hover:border-white/50"
            >
              {content.comfortCloud.partnerCta}
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>

        <div class="relative lg:row-start-1 lg:col-start-2">
          <div class="pointer-events-none absolute -inset-4 bg-accent-400/20 blur-3xl rounded-full" aria-hidden="true" />
          <Picture
            src={content.comfortCloud.image.src}
            alt={content.comfortCloud.image.alt}
            width={content.comfortCloud.image.width}
            height={content.comfortCloud.image.height}
            class="relative rounded-2xl shadow-2xl shadow-black/50 ring-1 ring-white/15 w-full object-cover"
            loading="lazy"
            sizes="(min-width: 1024px) 42vw, 100vw"
          />
        </div>

        <div class="space-y-5 lg:row-start-2 lg:col-start-2">
          <div class="rounded-3xl bg-white/5 border border-white/10 p-6 md:p-8 backdrop-blur-sm">
            <div class="flex items-center justify-between gap-4">
              <div class="rounded-lg bg-white px-3 py-2 shrink-0">
                <Picture
                  src={panasonicLogo.logo}
                  alt="Panasonic"
                  width={panasonicLogo.width}
                  height={panasonicLogo.height}
                  class="h-8 w-auto object-contain"
                  loading="lazy"
                />
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-accent-300">Comfort Cloud</span>
            </div>
            <p class="mt-4 text-sm text-neutral-300">
              {locale === "fr"
                ? "Application gratuite iOS & Android"
                : "Free iOS & Android app"}
            </p>
            <div class="mt-6 grid grid-cols-2 gap-3">
              {content.comfortCloud.features.map((f) => (
                <div class="rounded-xl bg-white/5 border border-white/10 p-4">
                  <div class="w-9 h-9 rounded-lg bg-accent-500/20 text-accent-300 flex items-center justify-center">
                    <Icon name={f.icon} size={18} />
                  </div>
                  <h3 class="mt-3 font-display font-bold text-sm text-white">{f.title}</h3>
                  <p class="mt-2 text-xs text-neutral-400 leading-relaxed">{f.text}</p>
                </div>
              ))}
            </div>
          </div>

          <a
            href={content.comfortCloud.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-sm font-semibold text-accent-300 hover:text-accent-200 underline-offset-2 hover:underline"
          >
            {content.comfortCloud.externalLabel}
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner locale={locale} title={content.cta.title} subtitle={content.cta.subtitle} colorScheme="primary" />

  <PartnersCertificationsSections locale={locale} />

  <section class="section bg-neutral-50" aria-labelledby="faq-clim-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 id="faq-clim-title" class="font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
          {content.faq.title}
        </h2>
      </div>
      <div class="mt-8 max-w-4xl">
        <Faq items={content.faq.items} idPrefix="clim-faq" />
      </div>
    </div>
  </section>
</BaseLayout>
