---
import type { Locale } from "@i18n";
import { pathFor } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Icon from "@components/Icon.astro";
import ProjectSection from "@components/ProjectSection.astro";
import StructuredData from "@components/StructuredData.astro";
import { site } from "@data/site";
import type { Project } from "@i18n/content/projects-shared";

interface Props {
  locale: Locale;
  seo: { title: string; description: string; keywords: string[] };
  breadcrumbs: { name: string; url: string }[];
  canonicalPath: string;
  hero: { badge: string; title: string; description: string; ctaQuote: string };
  intro?: {
    title: string;
    paragraphs: readonly string[];
    advantagesTitle: string;
    advantages: readonly string[];
  };
  projectLabel: string;
  projects: readonly Project[];
  cta: { title: string; subtitle: string };
  showInstallCta?: boolean;
}

const { locale, seo, breadcrumbs, canonicalPath, hero, intro, projectLabel, projects, cta, showInstallCta = true } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  keywords={[...seo.keywords]}
  canonicalPath={canonicalPath}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={breadcrumbs} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="bg-gradient-to-br from-accent-50 via-white to-accent-50/20">
    <div class="container-page py-10 md:py-16 max-w-4xl">
      <span class="badge bg-accent-100 text-accent-800">{hero.badge}</span>
      <h1 class="mt-3 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
        {hero.title}
      </h1>
      <p class="mt-4 text-lg text-neutral-700">{hero.description}</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a href={pathFor("contact", locale)} class="btn btn-accent"><Icon name="mail" size={18} /> {hero.ctaQuote}</a>
        <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent"><Icon name="phone" size={18} /> {site.phone}</a>
      </div>
    </div>
  </section>

  {intro && (
    <section class="section bg-white" aria-labelledby="projects-intro-title">
      <div class="container-page">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
          <div class="max-w-2xl">
            <h2
              id="projects-intro-title"
              class="font-display font-extrabold text-2xl md:text-3xl text-neutral-900 leading-tight"
            >
              {intro.title}
            </h2>
            <div class="mt-5 space-y-4 text-neutral-700 leading-relaxed">
              {intro.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          </div>

          <div class="rounded-2xl bg-gradient-to-br from-accent-50 via-accent-50/60 to-white border border-accent-100 p-6 md:p-8">
            <h3 class="font-display font-bold text-lg md:text-xl text-accent-800">
              {intro.advantagesTitle}
            </h3>
            <ul class="mt-5 space-y-3">
              {intro.advantages.map((a) => (
                <li class="flex items-start gap-2.5 text-sm md:text-base text-neutral-700">
                  <Icon name="check" size={18} class="text-accent-600 mt-0.5 shrink-0" strokeWidth={3} />
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  {projects.map((project, idx) => (
    <ProjectSection
      locale={locale}
      project={project}
      index={idx}
      projectLabel={projectLabel}
      eagerGallery={idx === 0}
      showInstallCta={showInstallCta}
    />
  ))}

  <CtaBanner locale={locale} title={cta.title} subtitle={cta.subtitle} />
</BaseLayout>
