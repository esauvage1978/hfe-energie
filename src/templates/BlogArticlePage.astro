---
import type { Locale, RouteId } from "@i18n";
import { pathFor } from "@i18n";
import type { BlogArticleContent } from "@i18n/content/blog-article-types";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Faq from "@components/Faq.astro";
import Icon from "@components/Icon.astro";
import StructuredData from "@components/StructuredData.astro";
import { getBlogMedia } from "@data/blog-media";
import { site } from "@data/site";

interface Props {
  locale: Locale;
  content: BlogArticleContent;
  routeId: RouteId;
  faqIdPrefix?: string;
}

const { locale, content, routeId, faqIdPrefix = "blog-faq" } = Astro.props;
const canonicalPath = pathFor(routeId, locale);
const primaryRoute = content.cta.primaryRouteId ?? "contact";
const primaryLabel =
  content.cta.primaryLabel ?? (locale === "en" ? "Free quote" : "Devis gratuit");

function resolvePaths(html: string): string {
  // Les RouteId peuvent contenir des chiffres (ex. blogReportageTf1Pac).
  return html.replace(/\{\{path:([a-zA-Z][a-zA-Z0-9]*)\}\}/g, (_, id: string) =>
    pathFor(id as RouteId, locale),
  );
}

const resolvedSections = content.sections.map((section) => ({
  ...section,
  html: resolvePaths(section.html),
}));

const hasLocalVideo = Boolean(content.video?.src);
const videoEmbedSrc = !hasLocalVideo
  ? content.video?.youtubeId
    ? `https://www.youtube-nocookie.com/embed/${content.video.youtubeId}`
    : content.video?.linkedinActivityId
      ? `https://www.linkedin.com/embed/feed/update/urn:li:activity:${content.video.linkedinActivityId}`
      : null
  : null;
const videoProvider = hasLocalVideo
  ? "file"
  : content.video?.youtubeId
    ? "youtube"
    : content.video?.linkedinActivityId
      ? "linkedin"
      : null;
const showVideo = Boolean(content.video && (hasLocalVideo || videoEmbedSrc));
const mediaBrand = getBlogMedia(content.hero.mediaId);
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  keywords={[...content.seo.keywords]}
  canonicalPath={canonicalPath}
  ogType="article"
>
  <StructuredData type="BreadcrumbList" breadcrumbs={[...content.breadcrumbs]} slot="head" />
  <StructuredData
    type="Article"
    article={{
      headline: content.article.headline,
      description: content.seo.description,
      path: canonicalPath,
      datePublished: content.article.datePublished,
      dateModified: content.article.dateModified,
      inLanguage: locale === "en" ? "en-GB" : "fr-FR",
    }}
    slot="head"
  />
  {content.faq.items.length > 0 && (
    <StructuredData type="FAQPage" faqs={[...content.faq.items]} slot="head" />
  )}

  <div class="container-page">
    <Breadcrumbs locale={locale} items={[...content.breadcrumbs]} />
  </div>

  <article>
    <header class="bg-gradient-to-br from-accent-50 via-white to-primary-50 border-b border-neutral-100">
      <div class="container-page py-10 md:py-14 max-w-3xl">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span class="badge bg-accent-100 text-accent-800">
            <Icon name="file-text" size={12} />
            {content.hero.badge}
          </span>
          {mediaBrand && (
            <img
              src={mediaBrand.logoSrc}
              alt={mediaBrand.logoAlt}
              width={mediaBrand.width}
              height={mediaBrand.height}
              class:list={["blog-article-media", `blog-article-media--${mediaBrand.id}`]}
              loading="eager"
              decoding="async"
            />
          )}
        </div>
        <h1 class="mt-4 font-display font-extrabold text-3xl sm:text-4xl md:text-[2.75rem] text-neutral-900 leading-tight">
          {content.article.headline}
        </h1>
        <p class="mt-3 text-sm text-neutral-500">
          <time datetime={content.article.datePublished}>{content.article.dateLabel}</time>
          <span class="mx-2" aria-hidden="true">·</span>
          {locale === "en" ? "By " : "Par "}<span class="font-medium text-neutral-700">{site.blogAuthor}</span>
          <span class="mx-2" aria-hidden="true">·</span>
          {content.hero.lead}
        </p>
        <p class="mt-5 text-lg text-neutral-700 leading-relaxed">{content.article.excerpt}</p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href={pathFor(primaryRoute, locale)} class="btn btn-accent">
            <Icon name="mail" size={18} />
            {primaryLabel}
          </a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent">
            <Icon name="phone" size={18} />
            {site.phone}
          </a>
        </div>
      </div>
    </header>

    <div class="section bg-white pt-8 md:pt-12">
      <div class="container-page">
        <div class="max-w-3xl prose-custom">
          {content.intro.map((paragraph) => (
            <p set:html={paragraph} />
          ))}

          {showVideo && content.video && (
            <figure class={`blog-video not-prose my-8 blog-video--${videoProvider}`}>
              <div class="blog-video__frame">
                {hasLocalVideo ? (
                  <video
                    controls
                    playsinline
                    preload="metadata"
                    title={content.video.title}
                    poster={content.video.poster}
                  >
                    <source src={content.video.src} type="video/mp4" />
                  </video>
                ) : (
                  <iframe
                    src={videoEmbedSrc!}
                    title={content.video.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  />
                )}
              </div>
              <figcaption class="mt-2 text-sm text-neutral-500">
                {content.video.title}
              </figcaption>
            </figure>
          )}

          {resolvedSections.map((section) => (
            <section aria-labelledby={section.id}>
              <h2 id={section.id}>{section.title}</h2>
              <div set:html={section.html} />
            </section>
          ))}
        </div>
      </div>
    </div>

    <CtaBanner locale={locale} title={content.cta.title} subtitle={content.cta.subtitle} />

    {content.faq.items.length > 0 && (
      <section class="section bg-neutral-50" aria-labelledby="blog-faq-title">
        <div class="container-page max-w-3xl">
          <h2 id="blog-faq-title" class="font-display text-2xl md:text-3xl font-extrabold text-neutral-900 mb-6">
            {content.faq.title}
          </h2>
          <Faq items={[...content.faq.items]} idPrefix={faqIdPrefix} />
        </div>
      </section>
    )}

    <section class="section bg-white" aria-labelledby="sources-title">
      <div class="container-page max-w-3xl">
        <h2 id="sources-title" class="font-display text-2xl font-extrabold text-neutral-900">
          {content.sources.title}
        </h2>
        <p class="mt-2 text-sm text-neutral-500">{content.sources.consulted}</p>
        <ol class="mt-4 space-y-2 list-decimal pl-5 text-sm text-neutral-700">
          {content.sources.items.map((source) => (
            <li>
              <a
                href={source.url}
                class="text-accent-700 underline underline-offset-2 hover:text-accent-800"
                rel="noopener noreferrer"
                target="_blank"
              >
                {source.label}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section bg-neutral-50 pt-0" aria-labelledby="related-title">
      <div class="container-page max-w-3xl">
        <h2 id="related-title" class="font-display text-xl font-extrabold text-neutral-900">
          {content.related.title}
        </h2>
        <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {content.related.links.map((link) => (
            <li>
              <a
                href={pathFor(link.routeId, locale)}
                class="flex items-center gap-2 rounded-xl border border-neutral-200 bg-white px-4 py-3 text-sm font-medium text-neutral-800 hover:border-accent-300 hover:text-accent-800 transition-colors"
              >
                <Icon name="arrow-right" size={16} class="text-accent-600 shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .blog-video__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1rem;
    background: #0f172a;
    box-shadow: 0 10px 28px rgb(0 73 122 / 0.12);
  }

  .blog-video--linkedin .blog-video__frame {
    aspect-ratio: 4 / 5;
    max-height: min(720px, 85vh);
  }

  .blog-video--file .blog-video__frame {
    aspect-ratio: 16 / 9;
  }

  .blog-video__frame iframe,
  .blog-video__frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .blog-video__frame video {
    object-fit: contain;
    background: #0f172a;
  }

  .blog-article-media {
    display: block;
    width: auto;
    height: 2rem;
    object-fit: contain;
  }

  .blog-article-media--tf1 {
    height: 1.85rem;
  }

  .blog-article-media--bfmtv {
    height: 2.75rem;
  }
</style>
