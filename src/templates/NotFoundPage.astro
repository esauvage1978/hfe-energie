---
import type { Locale } from "@i18n";
import { getNotFoundContent, pathFor } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import { site } from "@data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getNotFoundContent(locale);
const canonicalPath = pathFor("notFound", locale);
---

<BaseLayout locale={locale} title={content.seo.title} description={content.seo.description} noIndex canonicalPath={canonicalPath}>
  <section class="section bg-gradient-to-br from-accent-50 to-white">
    <div class="container-page max-w-3xl text-center">
      <Picture
        src="/assets/pageIntrouvable/404-error.jpg"
        alt={content.imageAlt}
        width={400}
        height={300}
        class="mx-auto max-w-xs sm:max-w-sm w-full rounded-2xl"
        loading="eager"
      />
      <p class="mt-6 font-display font-extrabold text-5xl md:text-7xl text-accent-700">{content.code}</p>
      <h1 class="mt-2 font-display text-3xl md:text-4xl font-extrabold text-neutral-900">
        {content.title}
      </h1>
      <p class="mt-3 text-neutral-700">{content.description}</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={pathFor("home", locale)} class="btn btn-accent"><Icon name="arrow-right" size={18} /> {content.ctaHome}</a>
        <a href={pathFor("heatPump", locale)} class="btn btn-outline-accent">{content.ctaHeatPump}</a>
        <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent"><Icon name="phone" size={18} /> {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
