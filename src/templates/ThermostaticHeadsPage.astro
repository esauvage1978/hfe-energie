---

import type { Locale } from "@i18n";

import { getThermostaticHeadsContent, pathFor } from "@i18n";

import BaseLayout from "@layouts/BaseLayout.astro";

import Breadcrumbs from "@components/Breadcrumbs.astro";

import CtaBanner from "@components/CtaBanner.astro";

import Icon from "@components/Icon.astro";

import Picture from "@components/Picture.astro";

import StructuredData from "@components/StructuredData.astro";

import { site } from "@data/site";



interface Props {

  locale: Locale;

}



const { locale } = Astro.props;

const content = getThermostaticHeadsContent(locale);

const canonicalPath = pathFor("thermostaticHeads", locale);

---



<BaseLayout

  locale={locale}

  title={content.seo.title}

  description={content.seo.description}

  keywords={[...content.seo.keywords]}

  canonicalPath={canonicalPath}

>

  <StructuredData type="BreadcrumbList" breadcrumbs={content.breadcrumbs} slot="head" />

  <StructuredData

    type="Service"

    service={{

      name: content.structuredData.serviceName,

      description: content.structuredData.serviceDescription,

      path: canonicalPath,

    }}

    slot="head"

  />



  <div class="container-page">

      <Breadcrumbs locale={locale} items={content.breadcrumbs} />

    </div>



    <section class="bg-gradient-to-br from-accent-50 via-white to-accent-50/20">

      <div class="container-page py-10 md:py-16">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

          <div>

            <span class="badge bg-accent-100 text-accent-800 border border-accent-200">{content.hero.badge}</span>

            <h1 class="mt-4 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">

              {content.hero.title}

            </h1>

            <p class="mt-4 text-lg text-neutral-700 leading-relaxed">{content.hero.description}</p>

            <div class="mt-6 flex flex-col sm:flex-row gap-3">

              <a href={pathFor("contact", locale)} class="btn btn-accent">

                <Icon name="mail" size={18} />

                {content.hero.ctaQuote}

              </a>

              <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent">

                <Icon name="phone" size={18} />

                {site.phone}

              </a>

            </div>

          </div>

          <div>

            <Picture

              src={content.hero.image.src}

              alt={content.hero.image.alt}

              width={content.hero.image.width}

              height={content.hero.image.height}

              style={`aspect-ratio: ${content.hero.image.width} / ${content.hero.image.height}`}

              class="rounded-3xl shadow-xl border border-accent-100 w-full object-cover"

              loading="eager"

              fetchpriority="high"

              decoding="sync"

              sizes="(min-width: 1024px) 50vw, 100vw"

            />

          </div>

        </div>

      </div>

    </section>



    <section class="section bg-accent-50/50 border-y border-accent-100" aria-labelledby="thermostatic-types-title">

      <div class="container-page">

        <h2 id="thermostatic-types-title" class="sr-only">{content.hero.title}</h2>



        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">

          <article class="card card-linkable border-accent-200 bg-white flex flex-col">
            <a
              href={pathFor(content.types.standard.projectsRoute, locale)}
              class="card-stretched-link"
              aria-label={content.types.standard.projectsLabel}
            />
            <div class="w-12 h-12 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center mb-4">
              <Icon name="radiator" size={24} />
            </div>
            <h3 class="font-display font-bold text-xl text-neutral-900">{content.types.standard.title}</h3>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed">{content.types.standard.description}</p>
            <ul class="mt-4 space-y-2 flex-1">
              {content.types.standard.benefits.map((b) => (
                <li class="flex items-start gap-2 text-sm text-neutral-700">
                  <Icon name="check" size={18} class="text-accent-600 shrink-0 mt-0.5" strokeWidth={3} />
                  {b}
                </li>
              ))}
            </ul>
            <span class="link-projects mt-6 self-start pointer-events-none" aria-hidden="true">
              <Icon name="star" size={14} />
              {content.types.standard.projectsLabel}
              <Icon name="arrow-right" size={14} />
            </span>
          </article>



          <article class="card card-linkable border-accent-300 bg-white ring-1 ring-accent-200 flex flex-col">
            <a
              href={pathFor(content.types.connected.projectsRoute, locale)}
              class="card-stretched-link"
              aria-label={content.types.connected.projectsLabel}
            />
            <div class="w-12 h-12 rounded-xl bg-accent-200 text-accent-800 flex items-center justify-center mb-4">
              <Icon name="radiator" size={24} />
            </div>
            <h3 class="font-display font-bold text-xl text-neutral-900">{content.types.connected.title}</h3>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed">{content.types.connected.description}</p>
            <ul class="mt-4 space-y-2 flex-1">
              {content.types.connected.benefits.map((b) => (
                <li class="flex items-start gap-2 text-sm text-neutral-700">
                  <Icon name="check" size={18} class="text-accent-600 shrink-0 mt-0.5" strokeWidth={3} />
                  {b}
                </li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-neutral-500 leading-relaxed border-t border-neutral-100 pt-4">
              {content.types.connected.brandsNote}
            </p>
            <span class="link-projects mt-6 self-start pointer-events-none" aria-hidden="true">
              <Icon name="star" size={14} />
              {content.types.connected.projectsLabel}
              <Icon name="arrow-right" size={14} />
            </span>
          </article>

        </div>

      </div>

    </section>



    <CtaBanner locale={locale} title={content.cta.title} subtitle={content.cta.subtitle} colorScheme="accent" />

</BaseLayout>

