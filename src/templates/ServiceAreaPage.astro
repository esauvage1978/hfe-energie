---
import type { Locale } from "@i18n";
import { getServiceAreaContent, pathFor } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CtaBanner from "@components/CtaBanner.astro";
import Faq from "@components/Faq.astro";
import Icon from "@components/Icon.astro";
import StructuredData from "@components/StructuredData.astro";
import ServiceAreaMap from "@components/ServiceAreaMap.tsx";
import ServiceAreaCommuneList from "@components/ServiceAreaCommuneList.tsx";
import { site } from "@data/site";
import {
  getServiceAreaDepartments,
  SERVICE_AREA_RADIUS_KM,
  serviceAreaData,
} from "@data/service-area";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getServiceAreaContent(locale);
const canonicalPath = pathFor("serviceArea", locale);
const departments = getServiceAreaDepartments();

const serviceLinks = [
  { route: "heatPump" as const, label: content.services.items[0].label, desc: content.services.items[0].description },
  { route: "airConditioning" as const, label: content.services.items[1].label, desc: content.services.items[1].description },
  { route: "heating" as const, label: content.services.items[2].label, desc: content.services.items[2].description },
  { route: "plumbing" as const, label: content.services.items[3].label, desc: content.services.items[3].description },
];
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  keywords={[...content.seo.keywords]}
  canonicalPath={canonicalPath}
>
  <StructuredData type="BreadcrumbList" breadcrumbs={content.breadcrumbs} slot="head" />
  <StructuredData type="FAQPage" faqs={content.faq.items} slot="head" />

  <div class="container-page">
    <Breadcrumbs items={content.breadcrumbs} />
  </div>

  <section class="bg-gradient-to-br from-accent-50 via-white to-accent-50/30">
    <div class="container-page py-10 md:py-14">
      <div class="max-w-3xl">
        <span class="badge bg-accent-100 text-accent-800">
          <Icon name="map-pin" size={12} />
          {content.hero.badge}
        </span>
        <h1 class="mt-3 font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-neutral-900 leading-tight">
          {content.hero.title}
        </h1>
        <p class="mt-4 text-lg text-neutral-700 leading-relaxed">{content.hero.description}</p>
        <address class="mt-4 not-italic text-sm text-neutral-600">
          <strong class="text-neutral-800">{site.address.street}</strong><br />
          {site.address.postalCode} {site.address.city}
        </address>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href={pathFor("contact", locale)} class="btn btn-accent">
            <Icon name="mail" size={18} />
            {content.hero.ctaQuote}
          </a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn-outline-accent">
            <Icon name="phone" size={18} />
            {content.hero.ctaContact}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="map-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 id="map-title" class="font-display text-2xl md:text-3xl font-extrabold text-neutral-900">
          {content.map.title}
        </h2>
        <p class="mt-3 text-neutral-700">{content.map.intro}</p>
      </div>
      <div class="mt-8">
        <ServiceAreaMap
          client:visible
          lat={serviceAreaData.center.lat}
          lng={serviceAreaData.center.lng}
          radiusKm={SERVICE_AREA_RADIUS_KM}
          label={serviceAreaData.center.label}
          ariaLabel={content.map.ariaLabel(SERVICE_AREA_RADIUS_KM)}
        />
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50" aria-labelledby="highlights-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 id="highlights-title" class="font-display text-2xl md:text-3xl font-extrabold text-neutral-900">
          {content.highlights.title}
        </h2>
        <p class="mt-3 text-neutral-700">{content.highlights.intro}</p>
      </div>
      <ul class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {site.serviceArea.map((city) => (
          <li class="flex items-center gap-2 p-3 rounded-xl bg-white border border-neutral-200 text-sm shadow-sm">
            <Icon name="map-pin" size={14} class="text-accent-600 shrink-0" />
            <span class="text-neutral-700 font-medium">{city}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="services-zone-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 id="services-zone-title" class="font-display text-2xl md:text-3xl font-extrabold text-neutral-900">
          {content.services.title}
        </h2>
        <p class="mt-3 text-neutral-700">{content.services.intro}</p>
      </div>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {serviceLinks.map((item) => (
          <a
            href={pathFor(item.route, locale)}
            class="card group hover:border-accent-300 transition-colors"
          >
            <h3 class="font-display font-bold text-lg text-neutral-900 group-hover:text-accent-700">
              {item.label}
            </h3>
            <p class="mt-2 text-sm text-neutral-600">{item.desc}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-accent-700">
              {locale === "fr" ? "En savoir plus" : "Learn more"}
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50" aria-labelledby="communes-title">
    <div class="container-page">
      <h2 id="communes-title" class="font-display text-2xl md:text-3xl font-extrabold text-neutral-900">
        {content.list.title}
      </h2>
      <div class="mt-6">
        <ServiceAreaCommuneList
          client:visible
          departments={departments}
          locale={locale}
          searchPlaceholder={content.list.searchPlaceholder}
          noResults={content.list.noResults}
        />
      </div>
    </div>
  </section>

  <Faq title={content.faq.title} items={content.faq.items} />

  <CtaBanner locale={locale} title={content.cta.title} subtitle={content.cta.subtitle} />
</BaseLayout>
